---
const protonLink = "https://pr.tn/ref/X0J3A3B2";
---

<a
  href={protonLink}
  target="_blank"
  rel="noopener noreferrer"
  class="relative mt-6 flex items-center gap-3 border border-[#202020]/15 dark:border-[#7c8fd1]/30 rounded-lg p-3 hover:bg-[#202020]/5 dark:hover:bg-[#7c8fd1]/10 transition-colors overflow-hidden"
>
  <span class="absolute top-0 right-0 bg-[#202020]/10 dark:bg-[#7c8fd1]/20 text-[10px] font-medium uppercase tracking-wider text-[#202020]/70 dark:text-[#7c8fd1] px-2 py-0.5 rounded-bl-lg">
    Ad
  </span>
  <img src="/Proton-logotype-purple-transparent.png" alt="Proton" class="h-8 w-auto" />
  <div class="text-left border-l border-[#202020]/15 dark:border-[#7c8fd1]/30 pl-3">
    <p class="text-sm font-semibold text-[#202020] dark:text-[#7c8fd1]">
      Privacy first
    </p>
    <p class="text-xs text-[#202020]/70 dark:text-[#96a6e2]/70">
        Encrypted Email, Drive, Calendar & VPN
    </p>
  </div>
</a>
---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredCases = [
  {
    name: "Luniv Technology",
    description:
      "My own software shop, specializing in custom software development, business intelligence, API integrations, and enterprise solutions for small to mid-sized businesses.",
    tags: ["Entrepreneurship", "Software Development", "Business Intelligence"],
    outcome:
      "Built a consultancy from the ground up, establishing credibility and generating leads through client work and case studies.",
    link: null,
  },
  {
    name: "ERP-CRM Integration API",
    description:
      "A robust middleware solution linking a legacy ERP system to a modern SaaS CRM, automating real-time inventory and customer data synchronization.",
    tags: ["Middleware", "API Development", "Integration"],
    outcome:
      "Eliminated manual data entry and stock discrepancies by establishing a reliable, automated sync pipeline.",
    link: null,
  },
  {
    name: "BOLD Talks",
    description:
      "An intimate speaker series bringing together curious minds in Grand Rapids for evenings of thoughtful dialogue with authors, academics, and thinkers.",
    tags: ["Events", "Community", "Web Design"],
    outcome:
      "Turned a cigar bar conversation series into a discoverable, RSVP-ready digital presence.",
    link: "https://bold-talks.com",
  },
  {
    name: "MPD Welding GR Inc.",
    description:
      "A lead-generation web presence for a Grand Rapids precision welding and steel treating shop, built to capture quotes and job applications around the clock.",
    tags: ["Industrial", "Web Design", "Lead Generation"],
    outcome: "Turned a legacy industrial site into a 24/7 quote intake and recruiting machine.",
    link: "https://www.mpdwelding.com",
  },
  {
    name: "Performance Management Platform",
    description:
      "An enterprise performance management platform built to streamline annual reviews, competency assessments, goal tracking, and executive reporting across the organization.",
    tags: ["Enterprise Software", "HR Tech", "Internal Tools"],
    outcome:
      "Replaced spreadsheet-driven review cycles with a configurable workflow platform managed entirely by HR administrators.",
    link: null,
  },
  {
    name: "Document Management Software",
    description:
      "A centralized document management system providing version control, approval workflows, metadata indexing, and enterprise search.",
    tags: ["Enterprise Software", "Document Management", "Internal Tools"],
    outcome: "Unified document storage and governance while improving searchability and compliance.",
    link: null,
  },
];

const openSourceProjects = [
  {
    title: "Snow Simulation",
    year: "2024",
    description:
      "A physics-based snow particle simulation built with C and raylib. Used by educators to demonstrate particle physics and collision detection.",
    link: "https://github.com/Sieep-Coding/snow-simulation",
    tech: ["C", "raylib"],
  },
  {
    title: "Chat Server in C#",
    year: "2025",
    description:
      "A simple TCP chat server written in C#. Used by educators to demonstrate socket programming and networking concepts.",
    link: "https://github.com/Sieep-Coding/simple-chat-csharp",
    tech: ["C#", ".NET"],
  },
  {
    title: "Spark",
    year: "2025",
    description: "My personal CRM built with Python and tkinter.",
    link: "https://github.com/Sieep-Coding/spark",
    tech: ["Python", "tkinter"],
  },
  {
    title: "nickstambaugh.dev",
    year: "2024",
    description: "My personal website, built with Astro and TypeScript.",
    link: "https://github.com/Sieep-Coding/sieep-coding.github.io",
    tech: ["Astro", "TypeScript"],
  },
  {
    title: "Lua Testing Framework",
    year: "2024",
    description: "A single-file, minimal Lua testing framework.",
    link: "https://github.com/Sieep-Coding/check-your-lua",
    tech: ["Lua"],
  },
  {
    title: "Laptop CLI",
    year: "2024",
    description: "Go CLI tool used to manage donated device inventory.",
    link: "https://github.com/Sieep-Coding/laptop-cli",
    tech: ["Go"],
  },
];
---

<BaseLayout title="Projects — Nick Stambaugh">
  <main class="max-w-6xl mx-auto px-4 py-16 sm:py-24">
    <header class="space-y-4 mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-secondary dark:text-dk-accent">
        Projects
      </h1>
      <p class="text-lg text-text dark:text-dk-text/80 leading-relaxed">
        Client and product work alongside the open source projects I build for
        fun. See <a
          class="text-inherit underline decoration-text/60 hover:decoration-text dark:decoration-dk-text/40 dark:hover:decoration-dk-text transition-colors"
          href="/about">about</a
        > for more on how I got here.
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-xl font-semibold text-secondary dark:text-dk-accent mb-6">
        Client &amp; Product Work
      </h2>

      <div class="space-y-3">
        {
          featuredCases.map((c) => {
            const Wrapper = c.link ? "a" : "div";
            return (
              <Wrapper
                {...(c.link
                  ? { href: c.link, target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class={`block border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6 transition-colors ${
                  c.link ? "hover:bg-secondary/10 dark:hover:bg-dk-secondary/10" : ""
                }`}
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-lg font-semibold text-secondary dark:text-dk-accent">
                    {c.name}
                  </h3>
                  {c.link && (
                    <span class="text-sm font-medium text-secondary dark:text-dk-accent shrink-0">
                      Visit →
                    </span>
                  )}
                </div>

                <p class="mt-2 text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                  {c.description}
                </p>

                <p class="mt-3 text-sm text-text/60 dark:text-dk-text/60 italic">
                  {c.outcome}
                </p>

                <div class="mt-3 flex flex-wrap gap-1.5">
                  {c.tags.map((tag) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-full border border-text/30 dark:border-dk-text/30 text-text/70 dark:text-dk-text/70">
                      {tag}
                    </span>
                  ))}
                </div>
              </Wrapper>
            );
          })
        }
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-secondary dark:text-dk-accent mb-6">
        Open Source &amp; Personal Projects
      </h2>

      <div class="space-y-3">
        {
          openSourceProjects.map((p) => (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group block border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6 hover:bg-secondary/10 dark:hover:bg-dk-secondary/10 transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold text-secondary dark:text-dk-accent">
                    {p.title}
                  </h3>
                  <p class="mt-2 text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                    {p.description}
                  </p>
                  <div class="mt-3 flex flex-wrap items-center gap-1.5">
                    {p.tech.map((t) => (
                      <span class="text-[11px] px-2 py-0.5 rounded-full border border-text/30 dark:border-dk-text/30 text-text/70 dark:text-dk-text/70">
                        {t}
                      </span>
                    ))}
                    <span class="text-xs text-text/50 dark:text-dk-text/50 ml-1">
                      {p.year}
                    </span>
                  </div>
                </div>
                <span class="text-text/40 dark:text-dk-text/40 group-hover:text-secondary dark:group-hover:text-dk-accent transition-colors shrink-0 mt-1">
                  ↗
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
      <a
        href="/"
        class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
      >
        ← Back to home
      </a>
    </footer>
  </main>
</BaseLayout>
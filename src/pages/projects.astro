---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredCases, openSourceProjects } from "../data/projects";
---

<BaseLayout title="Projects — Nick Stambaugh">
  <main class="max-w-6xl mx-auto px-4 py-16 sm:py-24">
    <header class="space-y-4 mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-secondary dark:text-dk-accent">
        Projects
      </h1>
      <p class="text-lg text-text dark:text-dk-text/80 leading-relaxed">
        Client and product work alongside the open source projects I build for
        fun. See <a
          class="text-inherit underline decoration-text/60 hover:decoration-text dark:decoration-dk-text/40 dark:hover:decoration-dk-text transition-colors"
          href="/about">about</a
        > for more on how I got here.
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-xl font-semibold text-secondary dark:text-dk-accent mb-6">
        Client &amp; Product Work
      </h2>

      <div class="space-y-3">
        {
          featuredCases.map((c) => {
            const Wrapper = c.link ? "a" : "div";
            return (
              <Wrapper
                {...(c.link
                  ? { href: c.link, target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class={`block border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6 transition-colors ${
                  c.link ? "hover:bg-secondary/10 dark:hover:bg-dk-secondary/10" : ""
                }`}
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-lg font-semibold text-secondary dark:text-dk-accent">
                    {c.name}
                  </h3>
                  {c.link && (
                    <span class="text-sm font-medium text-secondary dark:text-dk-accent shrink-0">
                      Visit →
                    </span>
                  )}
                </div>

                <p class="mt-2 text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                  {c.description}
                </p>

                <p class="mt-3 text-sm text-text/60 dark:text-dk-text/60 italic">
                  {c.outcome}
                </p>

                <div class="mt-3 flex flex-wrap gap-1.5">
                  {c.tags.map((tag) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-full border border-text/30 dark:border-dk-text/30 text-text/70 dark:text-dk-text/70">
                      {tag}
                    </span>
                  ))}
                </div>
              </Wrapper>
            );
          })
        }
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-secondary dark:text-dk-accent mb-6">
        Open Source &amp; Personal Projects
      </h2>

      <div class="space-y-3">
        {
          openSourceProjects.map((p) => (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group block border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6 hover:bg-secondary/10 dark:hover:bg-dk-secondary/10 transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold text-secondary dark:text-dk-accent">
                    {p.title}
                  </h3>
                  <p class="mt-2 text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                    {p.description}
                  </p>
                  <div class="mt-3 flex flex-wrap items-center gap-1.5">
                    {p.tech.map((t) => (
                      <span class="text-[11px] px-2 py-0.5 rounded-full border border-text/30 dark:border-dk-text/30 text-text/70 dark:text-dk-text/70">
                        {t}
                      </span>
                    ))}
                    <span class="text-xs text-text/50 dark:text-dk-text/50 ml-1">
                      {p.year}
                    </span>
                  </div>
                </div>
                <span class="text-text/40 dark:text-dk-text/40 group-hover:text-secondary dark:group-hover:text-dk-accent transition-colors shrink-0 mt-1">
                  ↗
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
      <a
        href="/"
        class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
      >
        ← Back to home
      </a>
    </footer>
  </main>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import Blog from "../components/post_section/Blog.astro";
import Contact from "../components/contact_section/Contact";
import { Image } from "astro:assets";
const allPosts = await Astro.glob("./posts/*.md");
import NavLinks from "../components/NavLinks.astro";
import FeedCarousel from "../components/FeedCarousel.astro";

const sortedPosts = [...allPosts].sort((a, b) => {
  const A = new Date(a.frontmatter.date).getTime();
  const B = new Date(b.frontmatter.date).getTime();
  return (isNaN(B) ? 0 : B) - (isNaN(A) ? 0 : A);
});
const latestPost = sortedPosts[0];
const latestPostTitle = latestPost?.frontmatter?.title || "Latest post";
const latestPostUrl = latestPost?.url || "/posts";
---

<BaseLayout title="Home - Nick Stambaugh">
  <main class="max-w-4xl mx-auto px-4 py-12 sm:py-24 space-y-4">
    <header
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-8"
    >
      <div class="space-y-2 order-2 sm:order-1">
        <div>
          <h1
            class="text-3xl font-bold tracking-tight text-secondary dark:text-dk-accent"
          >
            {info.name}
          </h1>
        </div>
        <p class="text-text dark:text-dk-text text-lg leading-relaxed pt-1">
          {info.brief_description}. This site is dedicated to his blog, music,
          and other interests.
        </p>
        <NavLinks />
      </div>
      <div class="order-1 sm:order-2 shrink-0">
        <Image
          src={info.picture}
          alt={info.picture_alt}
          width={96}
          height={96}
          class="h-48 w-48 rounded-full object-cover grayscale contrast-115 shadow-sm border border-text/10 dark:border-dk-text/10"
        />
      </div>
    </header>
    <FeedCarousel latestPostUrl={latestPostUrl} latestPostTitle={latestPostTitle} />
    <section id="blog">
      <Blog posts={allPosts} />
    </section>
    <br />
    <br />
    <section id="contact" class="pb-12">
      <div
        class="border border-text/10 dark:border-dk-text/10 bg-secondary/5 dark:bg-dk-secondary/5 rounded-xl p-6"
      >
        <Contact contact={info.contact} size="md" />
      </div>
    </section>
  </main>
  <script>
    const slidesWrap = document.getElementById("carousel-slides");
    const slides = Array.from(
      document.querySelectorAll<HTMLElement>(".carousel-slide"),
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLElement>(".carousel-dot"),
    );
    const carouselSection = document.getElementById("latest-carousel");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");

    let current = 0;
    let intervalId: ReturnType<typeof setInterval> | undefined;
    const AUTOPLAY_MS = 5000;

    function goTo(index: number) {
      if (slides.length === 0) return;
      current = ((index % slides.length) + slides.length) % slides.length;
      if (slidesWrap) {
        (slidesWrap as HTMLElement).style.transform =
          `translateX(-${current * 100}%)`;
      }
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-secondary", i === current);
        dot.classList.toggle("dark:bg-dk-accent", i === current);
        dot.classList.toggle("bg-text/30", i !== current);
        dot.classList.toggle("dark:bg-dk-text/30", i !== current);
      });
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function startAutoplay() {
      stopAutoplay();
      intervalId = setInterval(next, AUTOPLAY_MS);
    }

    function stopAutoplay() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = undefined;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.getAttribute("data-index"));
        goTo(idx);
        startAutoplay();
      });
    });

    prevBtn?.addEventListener("click", () => {
      prev();
      startAutoplay();
    });

    nextBtn?.addEventListener("click", () => {
      next();
      startAutoplay();
    });

    carouselSection?.addEventListener("mouseenter", stopAutoplay);
    carouselSection?.addEventListener("mouseleave", startAutoplay);

    goTo(0);
    startAutoplay();

    const weatherText = document.getElementById("weather-text");
    const weatherIcon = document.getElementById("weather-icon");

    const WEATHER_ICONS: Record<number, string> = {
      0: "☀️",
      1: "🌤️",
      2: "⛅",
      3: "☁️",
      45: "🌫️",
      48: "🌫️",
      51: "🌦️",
      53: "🌦️",
      55: "🌦️",
      61: "🌧️",
      63: "🌧️",
      65: "🌧️",
      71: "🌨️",
      73: "🌨️",
      75: "❄️",
      80: "🌦️",
      81: "🌧️",
      82: "⛈️",
      95: "⛈️",
      96: "⛈️",
      99: "⛈️",
    };

    async function loadWeather() {
      try {
        const res = await fetch(
          "https://api.open-meteo.com/v1/forecast?latitude=43.1195&longitude=-85.5606&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=America%2FDetroit",
        );
        const data = await res.json();
        const temp = Math.round(data.current.temperature_2m);
        const code = data.current.weather_code;
        if (weatherText) {
          weatherText.textContent = `${temp}°F`;
        }
        if (weatherIcon) {
          weatherIcon.textContent = WEATHER_ICONS[code] || "🌡️";
        }
      } catch (err) {
        if (weatherText) {
          weatherText.textContent = "Weather unavailable";
        }
      }
    }

    const quoteText = document.getElementById("quote-text");
    const quoteAuthor = document.getElementById("quote-author");

    async function loadQuote() {
      try {
        const res = await fetch("https://dummyjson.com/quotes/random");
        const data = await res.json();
        if (quoteText) {
          quoteText.textContent = `“${data.quote}”`;
        }
        if (quoteAuthor) {
          quoteAuthor.textContent = `— ${data.author}`;
        }
      } catch (err) {
        if (quoteText) {
          quoteText.textContent = "Couldn't load a quote right now.";
        }
      }
    }
    const wikiSlide = document.getElementById(
      "wiki-slide",
    ) as HTMLAnchorElement | null;
    const wikiTitle = document.getElementById("wiki-title");
    const wikiExcerpt = document.getElementById("wiki-excerpt");

    async function loadWikipediaArticle() {
      try {
        const res = await fetch(
          "https://en.wikipedia.org/api/rest_v1/page/random/summary",
        );

        const article = await res.json();

        if (wikiTitle) {
          wikiTitle.textContent = article.title;
        }

        if (wikiExcerpt) {
          wikiExcerpt.textContent =
            article.extract.length > 170
              ? article.extract.slice(0, 170) + "…"
              : article.extract;
        }

        if (wikiSlide) {
          wikiSlide.href = article.content_urls.desktop.page;
        }
      } catch {
        if (wikiTitle) wikiTitle.textContent = "Wikipedia unavailable";
        if (wikiExcerpt) {
          wikiExcerpt.textContent = "Couldn't load a random article.";
        }
      }
    }

    const onThisDaySlide = document.getElementById(
      "onthisday-slide",
    ) as HTMLAnchorElement | null;
    const onThisDayTitle = document.getElementById("onthisday-title");
    const onThisDayExcerpt = document.getElementById("onthisday-excerpt");

    async function loadOnThisDay() {
      try {
        const now = new Date();
        const mm = String(now.getMonth() + 1).padStart(2, "0");
        const dd = String(now.getDate()).padStart(2, "0");

        const res = await fetch(
          `https://en.wikipedia.org/api/rest_v1/feed/onthisday/events/${mm}/${dd}`,
        );
        const data = await res.json();
        const events = data.events || [];
        if (events.length === 0) throw new Error("No events");

        const event = events[Math.floor(Math.random() * events.length)];
        const page = event.pages?.[0];

        if (onThisDayTitle) {
          onThisDayTitle.textContent = event.year
            ? `${event.year}`
            : "On this day";
        }

        if (onThisDayExcerpt) {
          const text = event.text || "";
          onThisDayExcerpt.textContent =
            text.length > 170 ? text.slice(0, 170) + "…" : text;
        }

        if (onThisDaySlide) {
          onThisDaySlide.href =
            page?.content_urls?.desktop?.page ||
            `https://en.wikipedia.org/wiki/${mm}_${dd}`;
        }
      } catch {
        if (onThisDayTitle) onThisDayTitle.textContent = "Unavailable";
        if (onThisDayExcerpt) {
          onThisDayExcerpt.textContent = "Couldn't load today's event.";
        }
      }
    }

    loadWikipediaArticle();
    loadOnThisDay();
    loadWeather();
    loadQuote();
  </script>
</BaseLayout>

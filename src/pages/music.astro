---
import BaseLayout from "../layouts/BaseLayout.astro";
import { tracks, licenseOptions } from "../data/music";

const gradients = [
  "linear-gradient(135deg,#202020,#7c8fd1)",
  "linear-gradient(135deg,#7c8fd1,#202020)",
  "linear-gradient(135deg,#96a6e2,#202020)",
];

// Split into "current" (this year's drops) and "archive" (everything older).
// The vault holds anything that isn't from the most recent year present in the data.
const latestYear = Math.max(...tracks.map((t) => parseInt(t.year, 10)));
const currentTracks = tracks.filter((t) => parseInt(t.year, 10) === latestYear);
const archiveTracks = tracks.filter((t) => parseInt(t.year, 10) !== latestYear);

const allTags = Array.from(new Set(tracks.flatMap((t) => t.tags))).sort();
---

<BaseLayout title="Music — Nick Stambaugh">
  <main class="app-shell">
    <div class="content-scroll">
      <header class="hero">
        <p class="eyebrow">Nick Stambaugh</p>
        <h1 class="title">Music</h1>
        <p class="subtitle">
          Instrumentals and production work. Heavily influenced by hip-hop
          and cinematic game/movie sound design.
        </p>
        <div class="hero-actions">
          <button class="play-all-btn" id="play-all">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M8 5v14l11-7z"/></svg>
            Play All
          </button>
          <a href="mailto:nickstambaugh@proton.me" class="license-link">
            Email for licensing
          </a>
        </div>
        <p class="note">
          <strong>Note:</strong> Mastering may not be final, volume may be too loud, and some tracks are rough drafts.
        </p>
      </header>

      <!-- Filter rail: styled like console channel-strip buttons -->
      <div class="filter-rail" role="group" aria-label="Filter tracks by tag">
        <span class="filter-label">Filter</span>
        <div class="filter-chips" id="filter-chips">
          {allTags.map((tag) => (
            <button class="chip" data-tag={tag} type="button">{tag}</button>
          ))}
        </div>
        <button class="chip chip-clear hidden" id="clear-filters" type="button">Clear</button>
      </div>

      <section class="track-list" aria-label="Tracks" id="current-list">
        <div class="list-head">
          <span class="col-idx">#</span>
          <span class="col-title">Title</span>
          <span class="col-tags">Tags</span>
          <span class="col-year">Year</span>
          <span class="col-time">Time</span>
        </div>

        {currentTracks.map((track, i) => (
          <div
            class="track-row"
            data-src={track.src}
            data-id={track.id}
            data-title={track.title}
            data-artist={track.artist}
            data-tags={track.tags.join(",")}
            style={`--art:${gradients[i % gradients.length]}`}
          >
            <span class="col-idx">
              <span class="idx-num">{i + 1}</span>
              <button class="row-play-btn" aria-label={`Play ${track.title}`}>
                <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg class="icon-pause hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                <span class="mini-bars" aria-hidden="true"><i></i><i></i><i></i></span>
              </button>
            </span>

            <span class="col-title">
              <span class="titles">
                <span class="track-title">{track.title}</span>
                <span class="track-artist">{track.artist} · {track.type}</span>
                <span class="track-desc">{track.description}</span>
                <span class="mobile-meta">
                  {track.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
                  <span class="meta-year">{track.year}</span>
                </span>
              </span>
            </span>

            <span class="col-tags">
              {track.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
            </span>

            <span class="col-year">{track.year}</span>

            <span class="col-time time-display">—:——</span>

            <a
              href={track.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="yt-link"
              aria-label={`Watch ${track.title} on YouTube`}
              title="Watch on YouTube"
            >
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"/></svg>
            </a>
          </div>
        ))}
        <p class="empty-state hidden" id="current-empty">Nothing matches those tags yet.</p>
      </section>

      {archiveTracks.length > 0 && (
        <section class="vault" aria-label="Archive">
          <button class="vault-toggle" id="vault-toggle" aria-expanded="false" aria-controls="vault-body">
            <span class="vault-toggle-left">
              <svg class="vault-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="7" width="18" height="13" rx="1.5"/>
                <path d="M7 7V5.5A2.5 2.5 0 0 1 9.5 3h5A2.5 2.5 0 0 1 17 5.5V7"/>
              </svg>
              <span class="vault-title">The Vault</span>
              <span class="vault-count">{archiveTracks.length} track{archiveTracks.length === 1 ? "" : "s"} before {latestYear}</span>
            </span>
            <svg class="vault-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div class="vault-body" id="vault-body">
            <p class="vault-sub">Older sessions, kept on the shelf rather than deleted. Same filters apply below.</p>
            <div class="ledger" id="archive-list">
              {archiveTracks
                .sort((a, b) => parseInt(b.year, 10) - parseInt(a.year, 10))
                .map((track, i) => (
                <div
                  class="ledger-row track-row"
                  data-src={track.src}
                  data-id={track.id}
                  data-title={track.title}
                  data-artist={track.artist}
                  data-tags={track.tags.join(",")}
                >
                  <span class="ledger-year">{track.year}</span>
                  <span class="ledger-line" aria-hidden="true"></span>
                  <span class="col-idx">
                    <button class="row-play-btn" aria-label={`Play ${track.title}`}>
                      <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      <svg class="icon-pause hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                      <span class="mini-bars" aria-hidden="true"><i></i><i></i><i></i></span>
                    </button>
                  </span>
                  <span class="col-title">
                    <span class="titles">
                      <span class="track-title">{track.title}</span>
                      <span class="track-artist">{track.artist} · {track.type}</span>
                      <span class="track-desc">{track.description}</span>
                      <span class="mobile-meta">
                        {track.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
                      </span>
                    </span>
                  </span>
                  <span class="col-tags">
                    {track.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
                  </span>
                  <span class="col-time time-display">—:——</span>
                  <a
                    href={track.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="yt-link"
                    aria-label={`Watch ${track.title} on YouTube`}
                    title="Watch on YouTube"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"/></svg>
                  </a>
                </div>
              ))}
            </div>
            <p class="empty-state hidden" id="archive-empty">Nothing in the vault matches those tags.</p>
          </div>
        </section>
      )}

      <footer class="page-footer">
        <p>
          Interested in licensing or collaborating? Email me:{" "}
          <a href="mailto:nickstambaugh@proton.me">nickstambaugh@proton.me</a>
        </p>
      </footer>
    </div>

    <div class="player-bar" id="player-bar">
      <div class="pb-track">
        <span class="pb-art" id="pb-art"></span>
        <span class="pb-meta">
          <span class="pb-title" id="pb-title">Not playing</span>
          <span class="pb-artist" id="pb-artist">—</span>
        </span>
      </div>

      <div class="pb-controls">
        <div class="pb-buttons">
          <button class="pb-btn" id="pb-prev" aria-label="Previous track">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
          </button>
          <button class="pb-play-btn" id="pb-play" aria-label="Play/Pause">
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg class="icon-pause hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>
          <button class="pb-btn" id="pb-next" aria-label="Next track">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 18h2V6h-2zM6 18l8.5-6L6 6z"/></svg>
          </button>
        </div>
        <div class="pb-progress-row">
          <span class="pb-time" id="pb-current">0:00</span>
          <div class="pb-progress-track" id="pb-seek" role="slider" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
            <div class="pb-progress-fill" id="pb-fill" style="width:0%"></div>
            <div class="pb-progress-thumb" id="pb-thumb" style="left:0%"></div>
          </div>
          <span class="pb-time" id="pb-duration">0:00</span>
        </div>
      </div>

      <div class="pb-volume">
        <button class="pb-btn" id="pb-mute" aria-label="Toggle mute">
          <svg class="icon-vol" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
          <svg class="icon-mute hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
        </button>
        <input class="volume-range" id="pb-volume-slider" type="range" min="0" max="1" step="0.02" value="1" aria-label="Volume" />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .app-shell {
    --row-hover: rgba(32, 32, 32, 0.06);
    --row-active: rgba(32, 32, 32, 0.05);
    --border: rgba(32, 32, 32, 0.12);
    --text: #202020;
    --text-dim: rgba(32, 32, 32, 0.6);
    --text-faint: rgba(32, 32, 32, 0.35);
    --accent: #202020;
    --pill-border: rgba(32, 32, 32, 0.35);
    --bar-bg: rgba(32, 32, 32, 0.1);
    --bar-elevated: rgba(32, 32, 32, 0.04);
    --card-bg: rgba(32, 32, 32, 0.03);

    background: transparent;
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: inherit;
  }

  :global(html.dark) .app-shell {
    --row-hover: rgba(124, 143, 209, 0.1);
    --row-active: rgba(124, 143, 209, 0.08);
    --border: rgba(124, 143, 209, 0.18);
    --text: #96a6e2;
    --text-dim: rgba(150, 166, 226, 0.65);
    --text-faint: rgba(150, 166, 226, 0.35);
    --accent: #7c8fd1;
    --pill-border: rgba(124, 143, 209, 0.4);
    --bar-bg: rgba(124, 143, 209, 0.12);
    --bar-elevated: rgba(124, 143, 209, 0.06);
    --card-bg: rgba(124, 143, 209, 0.06);
  }

  .content-scroll {
    flex: 1;
    padding-bottom: 110px;
  }

  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  :global(html.dark) .title {
    background: linear-gradient(135deg, #aff6ff, #7c8fd1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 34rem;
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .play-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: #e8d8c8;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  :global(html.dark) .play-all-btn {
    color: #2a2b39;
  }

  .play-all-btn:hover {
    transform: scale(1.04);
    filter: brightness(1.1);
  }

  .license-link {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .license-link:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
    max-width: 32rem;
  }
  .note strong {
    color: var(--text-dim);
  }

  /* ---------- filter rail ---------- */
  .filter-rail {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .filter-chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.68rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--pill-border);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .chip:hover {
    border-color: var(--text);
  }
  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #e8d8c8;
  }
  :global(html.dark) .chip.active {
    color: #2a2b39;
  }

  .chip-clear {
    margin-left: auto;
    color: var(--text-faint);
    border-style: dashed;
  }

  .empty-state {
    padding: 1.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text-faint);
    text-align: center;
  }

  .license-info {
    max-width: 760px;
    margin: 0 auto;
    margin-top: 5%;
    padding: 0 1.5rem 2.5rem;
  }

  .license-info-head h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .license-info-sub {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    max-width: 34rem;
    line-height: 1.5;
  }

  .license-grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .license-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .license-card {
    border: 1px solid var(--border);
    background: var(--card-bg);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }

  .license-card h3 {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .license-card p {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .license-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .license-note a {
    color: var(--text-dim);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .license-note a:hover {
    color: var(--text);
  }

  .track-list {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .list-head {
    display: grid;
    grid-template-columns: 2.5rem 1fr 3rem 3.5rem 1.25rem;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.25rem;
  }
  .list-head .col-tags {
    display: none;
  }
  @media (min-width: 640px) {
    .list-head {
      grid-template-columns: 2.5rem 1fr auto 3rem 3.5rem 1.25rem;
    }
    .list-head .col-tags {
      display: block;
    }
  }

  /* mobile-only meta line (tags + year) shown under the title on small screens */
  .mobile-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }
  .mobile-meta .tag-pill {
    font-size: 0.6rem;
  }
  .meta-year {
    font-size: 0.65rem;
    color: var(--text-faint);
  }
  @media (min-width: 640px) {
    .mobile-meta {
      display: none;
    }
  }

  .track-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.25rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    position: relative;
    transition: background 0.15s ease;
  }
  @media (min-width: 640px) {
    .track-row {
      grid-template-columns: 2.5rem 1fr auto 3rem 3.5rem 1.25rem;
      gap: 1rem;
    }
  }
  .track-row:hover {
    background: var(--row-hover);
  }
  .track-row.is-playing {
    background: var(--row-active);
  }
  .track-row.is-playing .track-title {
    color: var(--accent);
  }
  .track-row.filtered-out {
    display: none;
  }

  .col-idx {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .idx-num {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .row-play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .track-row:hover .row-play-btn,
  .track-row.is-playing .row-play-btn {
    opacity: 1;
  }
  .track-row:hover .idx-num {
    opacity: 0;
  }
  .row-play-btn svg {
    width: 1rem;
    height: 1rem;
  }
  /* on mobile there's no idx-num to swap with in the ledger, so always show the button lightly */
  @media (max-width: 639px) {
    .row-play-btn {
      opacity: 0.55;
    }
    .track-row.is-playing .row-play-btn {
      opacity: 1;
    }
  }

  .mini-bars {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .track-row.is-playing:not(:hover) .row-play-btn {
    opacity: 1;
  }
  .track-row.is-playing:not(:hover) .icon-play,
  .track-row.is-playing:not(:hover) .icon-pause {
    display: none;
  }
  .track-row.is-playing:not(:hover) .mini-bars {
    display: flex;
  }
  .mini-bars i {
    width: 2px;
    background: var(--accent);
    display: inline-block;
    animation: mini-bounce 0.9s ease-in-out infinite;
  }
  .mini-bars i:nth-child(1) { height: 40%; animation-delay: 0s; }
  .mini-bars i:nth-child(2) { height: 100%; animation-delay: 0.2s; }
  .mini-bars i:nth-child(3) { height: 60%; animation-delay: 0.4s; }

  @keyframes mini-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .titles {

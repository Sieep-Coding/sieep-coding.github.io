---
import BaseLayout from "../layouts/BaseLayout.astro";
import { books } from "../data/library";

const tags = new Set();
for (const b of books) {
    (b.tags || []).forEach((t) => tags.add(t));
}

const slug = (t) =>
    t
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, "")
        .replace(/[\s_-]+/g, "-");

const stars = (rating) =>
    "★".repeat(Math.floor(rating)) +
    (rating % 1 === 0.5 ? "½" : "") +
    "☆".repeat(5 - Math.ceil(rating));
---

<BaseLayout title="Library — Nick Stambaugh">
    <main class="max-w-2xl mx-auto px-4 py-16 sm:py-24">
        <header class="space-y-4 mb-12">
            <h1
                class="text-3xl font-bold tracking-tight text-secondary dark:text-dk-accent"
            >
                Library
            </h1>
            <p class="text-lg text-text dark:text-dk-text/80 leading-relaxed">
                Physical books I own & have read. See <a
                    class="text-inherit underline decoration-text/60 hover:decoration-text dark:decoration-dk-text/40 dark:hover:decoration-dk-text transition-colors"
                    href="/about">about</a
                > for more on how I got here. The rating scale is 1 through 5 stars.
            </p>
            <p class="text-xs text-text/50 dark:text-dk-text/50">
                {books.length} books · tap a row to expand
            </p>
        </header>

        <div
            class="relative flex items-center mb-4 border-b-2 border-text/40 dark:border-dk-text/40 focus-within:border-secondary dark:focus-within:border-dk-accent transition-colors pb-1"
        >
            <input
                id="book-search"
                type="text"
                placeholder="Search books..."
                class="w-full py-3 bg-transparent text-text dark:text-dk-accent placeholder-text/60 dark:placeholder-dk-text/60 focus:outline-none text-xl font-medium tracking-wide"
            />

            <button
                id="filters-toggle"
                class="ml-4 px-4 py-2 text-sm uppercase font-bold tracking-widest text-text dark:text-dk-text hover:text-secondary dark:hover:text-dk-accent transition-colors focus:outline-none flex items-center gap-1"
            >
                <span>Tags</span>
                <span
                    id="filters-arrow"
                    class="inline-block transition-transform duration-200 text-xs"
                    >↓</span
                >
            </button>
        </div>

        <!-- Collapsible tag panel -->
        <div
            id="filters-panel"
            class="overflow-hidden transition-[max-height] duration-200 ease-out max-h-0"
        >
            <div
                id="tag-filter"
                class="flex flex-wrap gap-x-6 gap-y-3 pt-3 pb-8 border-b-2 border-text/10 dark:border-dk-text/10"
            >
                <button
                    data-filter="*"
                    class="tag-btn text-sm lowercase font-bold tracking-wide text-secondary dark:text-dk-accent decoration-secondary dark:decoration-dk-accent hover:text-secondary dark:hover:text-dk-accent transition-colors underline decoration-2 underline-offset-8"
                >
                    all
                </button>

                {
                    Array.from(tags).map((tag) => (
                        <button
                            data-filter={`.${slug(tag)}`}
                            class="tag-btn text-sm lowercase font-bold tracking-wide text-text/70 dark:text-dk-text hover:text-secondary dark:hover:text-dk-accent transition-colors underline decoration-2 decoration-transparent underline-offset-8"
                        >
                            {tag}
                        </button>
                    ))
                }
            </div>
        </div>

        <p
            id="no-results"
            class="hidden text-sm text-text/50 dark:text-dk-text/50 mb-8"
        >
            No books match your search.
        </p>

        <!-- Table -->
        <div
            class="border border-text/10 dark:border-dk-text/10 rounded-xl overflow-hidden"
        >
            <table class="w-full text-sm border-collapse table-fixed">
                <colgroup>
                <col class="w-[38%] sm:w-[38%]" />
                <col class="w-[18%] sm:w-[24%]" />
                <col class="w-[10%]" />
                <col class="w-[22%]" />
                <col class="w-[12%]" />
                </colgroup>
                <thead>
                    <tr
                        class="border-b border-text/10 dark:border-dk-text/10 bg-secondary/5 dark:bg-dk-secondary/5"
                    >
                        <th
                            class="text-left font-semibold uppercase tracking-wide text-[10px] sm:text-xs text-text/60 dark:text-dk-text/60 px-3 sm:px-4 py-3"
                        >
                            Title
                        </th>
                        <th
                            class="text-left font-semibold uppercase tracking-wide text-[10px] sm:text-xs text-text/60 dark:text-dk-text/60 px-3 sm:px-4 py-3"
                        >
                            Author
                        </th>
                        <th
                            class="text-left font-semibold uppercase tracking-wide text-[10px] sm:text-xs text-text/60 dark:text-dk-text/60 px-3 sm:px-4 py-3"
                        >
                            Year
                        </th>
                        <th
                            class="text-left font-semibold uppercase tracking-wide text-[10px] sm:text-xs text-text/60 dark:text-dk-text/60 px-3 sm:px-4 py-3"
                            >
                            Rating
                        </th>
                        <th class="px-2 py-3"></th>
                    </tr>
                </thead>
                <tbody id="books-list">
                    {
                        books.map((book, i) => {
                            const tagClasses = (book.tags || [])
                                .map((t) => slug(t))
                                .join(" ");
                            const tagsStr = (book.tags || []).join(",");
                            const isLast = i === books.length - 1;
                            const rowBorder = isLast
                                ? ""
                                : "border-b border-text/10 dark:border-dk-text/10";
                            return (
                                <>
                                    <tr
                                        class={`book-row book-item ${tagClasses} ${rowBorder} cursor-pointer hover:bg-secondary/5 dark:hover:bg-dk-secondary/5 transition-colors`}
                                        data-target={book.id}
                                        data-title={book.title.toLowerCase()}
                                        data-author={book.author.toLowerCase()}
                                        data-tags={tagsStr.toLowerCase()}
                                        data-description={book.description.toLowerCase()}
                                    >
                                        <td class="px-3 sm:px-4 py-3 align-top">
                                            <div class="font-semibold text-secondary dark:text-dk-accent">
                                                {book.title}
                                            </div>
                                            {book.subtitle && (
                                                <div class="text-xs text-text/50 dark:text-dk-text/50 mt-0.5">
                                                    {book.subtitle}
                                                </div>
                                            )}
                                        </td>
                                        <td class="px-3 sm:px-4 py-3 align-top text-text/80 dark:text-dk-text/80 text-xs sm:text-sm">
                                            {book.author}
                                        </td>
                                        <td class="px-3 sm:px-4 py-3 align-top text-text/60 dark:text-dk-text/60 text-xs sm:text-sm">
                                            {book.year}
                                        </td>
                                        <td class="px-3 sm:px-4 py-3 align-top whitespace-nowrap overflow-hidden">
                                        <span
                                            class="text-yellow-500 dark:text-yellow-400 font-medium"
                                            aria-label={`${book.rating} out of 5 stars`}
                                        >
                                            {stars(book.rating)}
                                        </span>
                                        </td>

                                        <td class="px-2 py-3 align-top text-right">
                                        <span
                                            class="book-arrow inline-block text-text/40 dark:text-dk-text/40 transition-transform duration-200"
                                            aria-hidden="true"
                                        >
                                            ↓
                                        </span>
                                        </td>
                                    </tr>
                                    <tr class="book-detail-row">
                                        <td colspan="5" class="p-0">
                                            <div
                                                id={`detail-${book.id}`}
                                                class="book-panel overflow-hidden transition-[max-height] duration-300 ease-out max-h-0"
                                            >
                                                <div
                                                    class={`px-3 sm:px-6 py-5 bg-secondary/5 dark:bg-dk-secondary/5 ${
                                                        isLast
                                                            ? ""
                                                            : "border-b border-text/10 dark:border-dk-text/10"
                                                    }`}
                                                >
                                                    <p class="text-sm text-text/80 dark:text-dk-text/80 leading-relaxed mb-4">
                                                        {book.description}
                                                    </p>

                                                    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-2 text-xs">
                                                        <div>
                                                            <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                Publisher
                                                            </dt>
                                                            <dd class="text-text/80 dark:text-dk-text/80 mt-0.5">
                                                                {book.publisher}
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                Format
                                                            </dt>
                                                            <dd class="text-text/80 dark:text-dk-text/80 mt-0.5">
                                                                {book.format}
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                Rating
                                                            </dt>
                                                            <dd class="text-yellow-500 dark:text-yellow-400 mt-0.5 font-medium">
                                                                {stars(book.rating)}
                                                                <span class="ml-1 text-text/70 dark:text-dk-text/70">
                                                                    ({book.rating}/5)
                                                                </span>
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                Pages
                                                            </dt>
                                                            <dd class="text-text/80 dark:text-dk-text/80 mt-0.5">
                                                                {book.pages}
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                ISBN
                                                            </dt>
                                                            <dd class="text-text/80 dark:text-dk-text/80 mt-0.5">
                                                                {book.isbn}
                                                            </dd>
                                                        </div>
                                                        {book.illustrator && (
                                                            <div class="col-span-2 sm:col-span-4">
                                                                <dt class="uppercase tracking-wide text-text/50 dark:text-dk-text/50">
                                                                    Illustrator
                                                                </dt>
                                                                <dd class="text-text/80 dark:text-dk-text/80 mt-0.5">
                                                                    {
                                                                        book.illustrator
                                                                    }
                                                                </dd>
                                                            </div>
                                                        )}
                                                    </dl>

                                                    <div class="mt-4 flex flex-wrap gap-1.5">
                                                        {book.tags.map(
                                                            (tag) => (
                                                                <span class="text-[11px] px-2 py-0.5 rounded-full border border-text/30 dark:border-dk-text/30 text-text/70 dark:text-dk-text/70">
                                                                    {tag}
                                                                </span>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </>
                            );
                        })
                    }
                </tbody>
            </table>
        </div>

        <footer
            class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10"
        >
            <a
                href="/"
                class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
            >
                ← Back to home
            </a>
        </footer>
    </main>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const searchEl = document.getElementById("book-search");
            const tagButtons = Array.from(
                document.querySelectorAll(".tag-btn"),
            );
            const rows = Array.from(document.querySelectorAll(".book-row"));
            const noResults = document.getElementById("no-results");

            let activeFilter = "*";

            const applyFilters = () => {
                const query = searchEl.value.toLowerCase();
                let visibleCount = 0;

                rows.forEach((row) => {
                    const title = row.dataset.title || "";
                    const author = row.dataset.author || "";
                    const tags = row.dataset.tags || "";
                    const description = row.dataset.description || "";
                    const textMatch =
                        title.includes(query) ||
                        author.includes(query) ||
                        tags.includes(query) ||
                        description.includes(query);
                    const filterMatch =
                        activeFilter === "*" ||
                        row.classList.contains(activeFilter.slice(1));

                    const show = textMatch && filterMatch;
                    const detailRow = row.nextElementSibling;

                    row.style.display = show ? "table-row" : "none";
                    if (detailRow) {
                        detailRow.style.display = show ? "table-row" : "none";
                    }
                    if (show) visibleCount++;
                });

                noResults.classList.toggle("hidden", visibleCount !== 0);
            };

            /* Auto-expand a specific book if ?book=<id> is present (used by the Nickipedia random-article / cross-links) */
            const params = new URLSearchParams(window.location.search);
            const wantedTag = params.get("tag");
            const wantedBook = params.get("book");

            tagButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    tagButtons.forEach((b) => {
                        b.classList.remove(
                            "text-secondary",
                            "dark:text-dk-accent",
                            "decoration-secondary",
                            "dark:decoration-dk-accent",
                        );
                        b.classList.add("text-text/70", "dark:text-dk-text");
                    });

                    btn.classList.remove("text-text/70", "dark:text-dk-text");
                    btn.classList.add(
                        "text-secondary",
                        "dark:text-dk-accent",
                        "decoration-secondary",
                        "dark:decoration-dk-accent",
                    );

                    activeFilter = btn.dataset.filter;
                    applyFilters();
                });
            });

            if (wantedTag) {
                const match = tagButtons.find((b) => b.dataset.filter === `.${wantedTag}`);
                if (match) match.click();
            }

            searchEl.addEventListener("input", applyFilters);

            /* Tag filter collapsible panel */
            const panel = document.getElementById("filters-panel");
            const toggle = document.getElementById("filters-toggle");
            const arrow = document.getElementById("filters-arrow");

            let open = false;
            panel.style.maxHeight = "0px";

            toggle.addEventListener("click", () => {
                open = !open;
                if (open) {
                    panel.style.maxHeight = panel.scrollHeight + "px";
                    arrow.style.transform = "rotate(180deg)";
                } else {
                    panel.style.maxHeight = "0px";
                    arrow.style.transform = "rotate(0deg)";
                }
            });

            /* Row accordion: click a row to expand/collapse its detail row */
            rows.forEach((row) => {
                const targetId = row.dataset.target;
                const detailPanel = document.getElementById(
                    `detail-${targetId}`,
                );
                const arrowEl = row.querySelector(".book-arrow");

                row.addEventListener("click", () => {
                    const isOpen = row.getAttribute("aria-expanded") === "true";
                    row.setAttribute("aria-expanded", String(!isOpen));

                    if (isOpen) {
                        detailPanel.style.maxHeight = "0px";
                        arrowEl.style.transform = "rotate(0deg)";
                    } else {
                        detailPanel.style.maxHeight =
                            detailPanel.scrollHeight + "px";
                        arrowEl.style.transform = "rotate(180deg)";
                    }
                });
            });

            applyFilters();

            if (wantedBook) {
                const row = rows.find((r) => r.dataset.target === wantedBook);
                if (row) {
                    row.scrollIntoView({ behavior: "smooth", block: "center" });
                    row.click();
                }
            }
        });
    </script>
</BaseLayout>
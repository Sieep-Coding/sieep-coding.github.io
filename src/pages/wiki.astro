          <script define:vars={{ GITHUB_USERNAME }}>
            function initGithubActivity() {
              const list = document.getElementById("github-recent-commits");
              if (!list || list.dataset.loaded) return;
              list.dataset.loaded = "true";
              fetch(
                `https://api.github.com/users/${GITHUB_USERNAME}/events/public`,
              )
                .then((res) => (res.ok ? res.json() : Promise.reject()))
                .then((events) => {
                  const pushes = (events || [])
                    .filter((e) => e.type === "PushEvent")
                    .flatMap((e) =>
                      (e.payload?.commits || []).map((c) => ({
                        message: (c.message || "").split("\n")[0],
                        repo: e.repo?.name?.split("/")?.[1] ?? e.repo?.name,
                        url: `https://github.com/${e.repo?.name}/commit/${c.sha}`,
                      })),
                    )
                    .slice(0, 5);

                  if (pushes.length === 0) {
                    list.innerHTML = `<li class="text-xs text-text/50 dark:text-dk-text/50">No recent public commits found.</li>`;
                    return;
                  }

                  list.innerHTML = pushes
                    .map(
                      (c) => `
                    <li class="text-sm">
                      <a href="${c.url}" target="_blank" rel="noopener noreferrer" class="text-text dark:text-dk-text hover:text-secondary dark:hover:text-dk-accent hover:underline underline-offset-4 transition-colors truncate block">${c.message || "(no message)"}</a>
                      <span class="text-[10px] text-text/40 dark:text-dk-text/40">${c.repo}</span>
                    </li>
                  `,
                    )
                    .join("");
                })
                .catch(() => {
                  list.innerHTML = `<li class="text-xs text-text/50 dark:text-dk-text/50">Couldn't load recent commits.</li>`;
                });
            }
            initGithubActivity();
            document.addEventListener("astro:page-load", initGithubActivity);
          </script>


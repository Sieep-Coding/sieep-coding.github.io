---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagGraph from "../components/TagGraph.astro";
import { Image } from "astro:assets";
import { info } from "../data/info";
import { books } from "../data/library";
import { mediaList } from "../data/media";
import { tracks } from "../data/music";
import { featuredCases, openSourceProjects } from "../data/projects";
import { brucePhotos } from "../data/bruce";
import { apps } from "./apps.astro";
import { recipes } from "./recipes.astro";
import ProtonAdAstroComponent from "../components/about_section/ProtonAd.astro";
import NavLinks from "../components/NavLinks.astro";
import FeedCarousel from "../components/FeedCarousel.astro";

const allPosts = await Astro.glob("./posts/*.md");

const sortedPosts = [...allPosts].sort((a, b) => {
  const A = new Date(a.frontmatter.date).getTime();
  const B = new Date(b.frontmatter.date).getTime();
  return (isNaN(B) ? 0 : B) - (isNaN(A) ? 0 : A);
});

const graphPosts = allPosts.map((p) => ({
  title: p.frontmatter.title || "Untitled",
  url: p.url,
  tags: p.frontmatter.tags || [],
}));

const postSearchData = allPosts.map((post) => ({
  type: "Article",
  title: post.frontmatter.title || "Untitled",
  description: post.frontmatter.description || "",
  url: post.url,
}));

const latestPost = sortedPosts[0];


const latestPostTitle = latestPost?.frontmatter?.title || "Latest post";
const latestPostUrl = latestPost?.url || "/posts";

const librarySearchData = books.map((b) => ({
  type: "Book",
  title: b.title,
  description: b.description,
  url: `/library?book=${b.id}`,
}));

const mediaSearchData = mediaList.map((m) => ({
  type: "Media",
  title: m.title,
  description: m.description,
  url: `/media?item=${m.id}`,
}));

const musicSearchData = tracks.map((t) => ({
  type: "Track",
  title: t.title,
  description: t.description,
  url: "/music",
}));

const projectSearchData = [
  ...featuredCases.map((c) => ({
    type: "Project",
    title: c.name,
    description: c.description,
    url: c.link || "/projects",
  })),
  ...openSourceProjects.map((p) => ({
    type: "Project",
    title: p.title,
    description: p.description,
    url: p.link || "/projects",
  })),
];

const unifiedSearchData = [
  ...postSearchData,
  ...librarySearchData,
  ...mediaSearchData,
  ...musicSearchData,
  ...projectSearchData,
];

const featured = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 6);
const totalPosts = allPosts.length;
const appsList = apps;

const recipeCount = recipes.length;

const GITHUB_USERNAME = "Sieep-Coding";

let githubStats = {
  topRepo: "simple-chat-csharp",
  stars: 27,
  publicRepos: null as number | null,
  totalStars: null as number | null,
  languages: [] as { name: string; count: number }[],
  recentRepos: [] as {
    name: string;
    url: string;
    pushedAt: string;
    language: string | null;
  }[],
};

try {
  const ghRes = await fetch(
    `https://api.github.com/users/${GITHUB_USERNAME}/repos?per_page=100&sort=updated`,
  );
  if (ghRes.ok) {
    const repos = await ghRes.json();
    if (Array.isArray(repos) && repos.length) {
      const nonForks = repos.filter((r: any) => !r.fork);
      const top = [...repos].sort(
        (a, b) => (b.stargazers_count ?? 0) - (a.stargazers_count ?? 0),
      )[0];
      const totalStars = repos.reduce(
        (sum: number, r: any) => sum + (r.stargazers_count ?? 0),
        0,
      );

      const langCounts = new Map<string, number>();
      for (const r of nonForks) {
        if (!r.language) continue;
        langCounts.set(r.language, (langCounts.get(r.language) ?? 0) + 1);
      }
      const languages = Array.from(langCounts.entries())
        .map(([name, count]) => ({ name, count }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 8);

      const recentRepos = [...nonForks]
        .sort(
          (a: any, b: any) =>
            new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime(),
        )
        .slice(0, 5)
        .map((r: any) => ({
          name: r.name,
          url: r.html_url,
          pushedAt: r.pushed_at,
          language: r.language,
        }));

      githubStats = {
        topRepo: top.name,
        stars: top.stargazers_count ?? 0,
        publicRepos: repos.length,
        totalStars,
        languages,
        recentRepos,
      };
    }
  }
} catch (err) {}

const maxLangCount = Math.max(1, ...githubStats.languages.map((l) => l.count));
const languageColors = [
  "#b45f4d",
  "#5f8fb4",
  "#8a5fb4",
  "#5fb47d",
  "#c9a227",
  "#c95f8a",
  "#5fb4ac",
  "#a2765f",
];

const wikipediaLinksMap = new Map<
  string,
  {
    label: string;
    url: string;
    wikiTitle: string;
    wikiHost: string;
    postTitle: string;
    postUrl: string;
  }
>();

const wikiHrefPattern =
  /href="(https?:\/\/(?:[a-z]{2,3}\.)?wikipedia\.org\/wiki\/[^"]+)"/gi;
const bruceHrefPattern = /href="\/bruce-the-dog"/gi;

const postWordCounts: { post: (typeof allPosts)[number]; words: number }[] =
  [];
let bruceLinkCount = 0;
const bruceLinkingPosts: { title: string; url: string; count: number }[] = [];

for (const post of allPosts) {
  let html = "";
  try {
    html = await post.compiledContent();
  } catch (err) {
    continue;
  }

  const plainText = html.replace(/<[^>]*>/g, " ");
  const words = plainText.split(/\s+/).filter(Boolean).length;
  postWordCounts.push({ post, words });

  const bruceMatches = html.match(bruceHrefPattern);
  if (bruceMatches && bruceMatches.length) {
    bruceLinkCount += bruceMatches.length;
    bruceLinkingPosts.push({
      title: post.frontmatter.title,
      url: post.url,
      count: bruceMatches.length,
    });
  }

  for (const match of html.matchAll(wikiHrefPattern)) {
    const url = match[1];
    const rawTitle = url.split("/wiki/").pop() ?? "Wikipedia";
    const decoded = decodeURIComponent(rawTitle.replaceAll("_", " "));
    let host = "en.wikipedia.org";
    try {
      host = new URL(url).hostname;
    } catch (err) {}
    if (!wikipediaLinksMap.has(url)) {
      wikipediaLinksMap.set(url, {
        label: decoded,
        url,
        wikiTitle: rawTitle,
        wikiHost: host,
        postTitle: post.frontmatter.title,
        postUrl: post.url,
      });
    }
  }
}

const wikipediaLinks = Array.from(wikipediaLinksMap.values());

const shortestPost = postWordCounts.length
  ? postWordCounts.reduce((a, b) => (b.words < a.words ? b : a))
  : null;

bruceLinkingPosts.sort((a, b) => b.count - a.count);

const didYouKnow = [
  `...that Nick's degrees are in <a href="/about" class="text-secondary dark:text-dk-accent underline underline-offset-4">economics and philosophy</a>, not computer science?`,
  `...that Nick's most-starred repo on GitHub is <a href="https://github.com/Sieep-Coding/${githubStats.topRepo}" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">${githubStats.topRepo}</a>, with ${githubStats.stars} stars?`,
  `...that Nick's dog <a href="/bruce-the-dog" class="text-secondary dark:text-dk-accent underline underline-offset-4">Bruce</a> is a Norwegian Elkhound mixed with a Schipperke?`,
  `...that Nick produces music under the name <a href="/music" class="text-secondary dark:text-dk-accent underline underline-offset-4">sieep</a>, made in FL Studio?`,
  `...that Nick's rating scale for <a href="/library" class="text-secondary dark:text-dk-accent underline underline-offset-4">books</a> and <a href="/media" class="text-secondary dark:text-dk-accent underline underline-offset-4">media</a> goes up to 5 stars, half-stars included?`,
  `...that Nick's blog spans <a href="/tags" class="text-secondary dark:text-dk-accent underline underline-offset-4">10+ topics</a>, from nuclear economics to old comic books?`,
  `...that before software, Nick wrote a <a href="/posts/making-nuclear-energy-competitve-with-fossil-fuels-and-natural-gas" class="text-secondary dark:text-dk-accent underline underline-offset-4">report on nuclear reactor economics</a> for Michigan's NERS department?`,
  `...that Nick has written up trips to <a href="/posts/chicago" class="text-secondary dark:text-dk-accent underline underline-offset-4">Chicago</a> and <a href="/posts/houston" class="text-secondary dark:text-dk-accent underline underline-offset-4">Houston</a>?`,
  `...that Nick has strong opinions about <a href="/posts/my-thoughts-on-soccer" class="text-secondary dark:text-dk-accent underline underline-offset-4">football</a> — the kind played with your feet?`,
  `...that this site runs ad-free, but you can <a href="https://www.buymeacoffee.com/nickstambaugh" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">buy him a coffee</a> anyway?`,
  `...that the site itself is hand-coded in <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">Astro</a>, React, and TypeScript?`,
  `...that Nick has his own <a href="/apps" class="text-secondary dark:text-dk-accent underline underline-offset-4">app store</a>, with ${apps.length} ${apps.length === 1 ? "app" : "apps"} so far?`,
  `...that Nick has a <a href="/recipes" class="text-secondary dark:text-dk-accent underline underline-offset-4">recipe archive</a> with ${recipeCount} ${recipeCount === 1 ? "recipe" : "recipes"}?`,
  `...that Nick's <a href="/library" class="text-secondary dark:text-dk-accent underline underline-offset-4">library</a> holds ${books.length} physical books he's actually read?`,
  `...that Nick has ${mediaList.length} entries in his ultra-curated <a href="/media" class="text-secondary dark:text-dk-accent underline underline-offset-4">favorite media</a> list?`,
  `...that ${tracks.length} tracks are currently live on Nick's <a href="/music" class="text-secondary dark:text-dk-accent underline underline-offset-4">music page</a>, licenseable by email?`,
];

const tagMap = new Map();
for (const post of allPosts) {
  const postTags = post.frontmatter.tags || [];
  for (const raw of postTags) {
    const key = raw
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-");
    if (!key) continue;
    const label = raw.replace(/^#/, "");
    const existing = tagMap.get(key);
    if (existing) existing.count += 1;
    else tagMap.set(key, { label, count: 1 });
  }
}
const topTags = Array.from(tagMap.entries())
  .map(([key, v]) => ({ key, ...v }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);


const allTagKeys = Array.from(tagMap.keys());
const dayOfYear = (() => {
  const now = new Date();
  const start = new Date(now.getFullYear(), 0, 0);
  const diff = now.getTime() - start.getTime();
  return Math.floor(diff / 86400000);
})();
const tagOfDayKey = allTagKeys.length
  ? allTagKeys[dayOfYear % allTagKeys.length]
  : null;
const tagOfDay = tagOfDayKey ? tagMap.get(tagOfDayKey) : null;
const tagOfDayPosts = tagOfDayKey
  ? allPosts.filter((p) =>
      (p.frontmatter.tags || []).some((t: string) => {
        const key = t
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, "")
          .replace(/[\s_-]+/g, "-");
        return key === tagOfDayKey;
      }),
    )
  : [];


const tagsByYear = new Map<number, Map<string, number>>();
for (const post of allPosts) {
  const d = new Date(post.frontmatter.date);
  if (isNaN(d.getTime())) continue;
  const year = d.getFullYear();
  if (!tagsByYear.has(year)) tagsByYear.set(year, new Map());
  const yearMap = tagsByYear.get(year)!;
  for (const raw of post.frontmatter.tags || []) {
    const key = raw
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-");
    if (!key) continue;
    yearMap.set(key, (yearMap.get(key) ?? 0) + 1);
  }
}
const tagEvolution = Array.from(tagsByYear.entries())
  .sort((a, b) => a[0] - b[0])
  .map(([year, m]) => ({
    year,
    topTags: Array.from(m.entries())
      .map(([key, count]) => ({ label: tagMap.get(key)?.label ?? key, count }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5),
  }));

const portals = [
  {
    href: "/posts",
    label: "Posts",
    desc: `${totalPosts} articles`,
    icon: "📝",
  },
  {
    href: "/music",
    label: "Music",
    desc: `${tracks.length} tracks`,
    icon: "🎵",
  },
  {
    href: "/recipes",
    label: "Recipes",
    desc: recipeCount !== null ? `${recipeCount} recipes` : "Cooking archive",
    icon: "🍳",
  },
  {
    href: "/library",
    label: "Library",
    desc: `${books.length} books`,
    icon: "📚",
  },
  {
    href: "/media",
    label: "Media",
    desc: `${mediaList.length} favorites`,
    icon: "🎬",
  },
  {
    href: "/projects",
    label: "Projects",
    desc: `${featuredCases.length + openSourceProjects.length} builds`,
    icon: "🛠️",
  },
  { href: "/bruce-the-dog", label: "Bruce", desc: "The dog", icon: "🐕" },
  { href: "/about", label: "About", desc: "Nick Stambaugh", icon: "👤" },
  { href: "/apps", label: "Apps", desc: "My apps", icon: "📱" },
];

const randomArticles = [
  ...allPosts.map((p) => ({
    title: p.frontmatter.title || "Untitled",
    url: p.url,
    type: "Article",
  })),
  { title: "Library", url: "/library", type: "Portal" },
  { title: "Favorite Media", url: "/media", type: "Portal" },
  { title: "Projects", url: "/projects", type: "Portal" },
  { title: "Music", url: "/music", type: "Portal" },
  { title: "Bruce the Dog", url: "/bruce-the-dog", type: "Portal" },
  { title: "About Nick", url: "/about", type: "Portal" },
];

const formatCounts = [
  { label: "Books", count: books.length, href: "/library" },
  { label: "Articles", count: totalPosts, href: "/posts" },
  { label: "Apps", count: appsList.length, href: "/apps" },
  { label: "Media", count: mediaList.length, href: "/media" },
  { label: "Tracks", count: tracks.length, href: "/music" },
  {
    label: "Projects",
    count: featuredCases.length + openSourceProjects.length,
    href: "/projects",
  },
];
if (recipeCount !== null) {
  formatCounts.push({ label: "Recipes", count: recipeCount, href: "/recipes" });
}
const maxFormatCount = Math.max(1, ...formatCounts.map((f) => f.count));

const topBookRating = Math.max(...books.map((b) => b.rating));
const topBooks = books.filter((b) => b.rating === topBookRating);
const topBook = topBooks[Math.floor(Math.random() * topBooks.length)];

const topMediaRating = Math.max(...mediaList.map((m) => m.rating));
const topMediaItems = mediaList.filter((m) => m.rating === topMediaRating);
const topMedia =
  topMediaItems[Math.floor(Math.random() * topMediaItems.length)];


const worstBookRating = books.length
  ? Math.min(...books.map((b) => b.rating))
  : null;
const worstBooks = books.filter((b) => b.rating === worstBookRating);
const worstBook = worstBooks.length
  ? worstBooks[Math.floor(Math.random() * worstBooks.length)]
  : null;

const worstMediaRating = mediaList.length
  ? Math.min(...mediaList.map((m) => m.rating))
  : null;
const worstMediaItems = mediaList.filter((m) => m.rating === worstMediaRating);
const worstMedia = worstMediaItems.length
  ? worstMediaItems[Math.floor(Math.random() * worstMediaItems.length)]
  : null;


function extractDate(item: any, keys: string[]): Date | null {
  for (const k of keys) {
    const v = item?.[k];
    if (!v) continue;
    const d = new Date(v);
    if (!isNaN(d.getTime())) return d;
  }
  return null;
}

const growthRaw = [
  {
    label: "Articles",
    color: "#7c8fd1",
    dates: allPosts
      .map((p) => extractDate(p.frontmatter, ["date"]))
      .filter((d): d is Date => d !== null),
  }
];

const growthSeriesRaw = growthRaw.filter((s) => s.dates.length > 0);
const skippedGrowthSeries = growthRaw
  .filter((s) => s.dates.length === 0)
  .map((s) => s.label);

let growthChart: {
  years: number[];
  seriesPaths: {
    label: string;
    color: string;
    points: string;
    lastX: number;
    lastY: number;
  }[];
  chartW: number;
  chartH: number;
  padL: number;
  yTicks: { value: number; y: number }[];
  yearLabels: { year: number; x: number }[];
} | null = null;

if (growthSeriesRaw.length > 0) {
  const allYears = growthSeriesRaw.flatMap((s) =>
    s.dates.map((d) => d.getFullYear()),
  );
  const minYear = Math.min(...allYears);
  const maxYear = Math.max(...allYears, new Date().getFullYear());
  const years: number[] = [];
  for (let y = minYear; y <= maxYear; y++) years.push(y);

  const seriesWithCumulative = growthSeriesRaw.map((s) => ({
    ...s,
    counts: years.map(
      (y) => s.dates.filter((d) => d.getFullYear() <= y).length,
    ),
  }));

  const maxCount = Math.max(1, ...seriesWithCumulative.flatMap((s) => s.counts));
  const chartW = 640;
  const chartH = 220;
  const padL = 30;
  const padB = 22;
  const padT = 10;
  const padR = 10;
  const plotW = chartW - padL - padR;
  const plotH = chartH - padT - padB;

  const xFor = (i: number) =>
    padL + (years.length === 1 ? plotW / 2 : (i / (years.length - 1)) * plotW);
  const yFor = (count: number) => padT + plotH - (count / maxCount) * plotH;

  const seriesPaths = seriesWithCumulative.map((s) => ({
    label: s.label,
    color: s.color,
    points: s.counts.map((c, i) => `${xFor(i)},${yFor(c)}`).join(" "),
    lastX: xFor(s.counts.length - 1),
    lastY: yFor(s.counts[s.counts.length - 1]),
  }));

  const yTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => {
    const value = Math.round(f * maxCount);
    return { value, y: yFor(value) };
  });

  const yearLabels = years
    .map((year, i) => ({ year, x: xFor(i), i }))
    .filter(
      (yl) =>
        yl.i === 0 || yl.i === years.length - 1 || years.length <= 8 || yl.year % 2 === 0,
      )
      .map(({ year, x }) => ({ year, x }));
      
      growthChart = { years, seriesPaths, chartW, chartH, padL, yTicks, yearLabels };
    }
    ---

<BaseLayout title="Nickipedia - Nick's Wiki">
  <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen">
    <main
    class="max-w-[1400px] mx-auto px-4 sm:px-8 pt-28 pb-10 sm:pt-32 sm:pb-16"
    >
    <header
    class="border-b-4 border-secondary/20 dark:border-dk-accent/20 pb-4 mb-8"
    >
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h1
        class="text-4xl sm:text-5xl font-serif font-bold tracking-tight text-secondary dark:text-dk-accent"
        >
        Nickipedia
        </h1>
        <p class="text-sm mt-4 italic text-text/60 dark:text-dk-text/60 mt-1">
          Version 0.4
          </p>
          <p
          id="wiki-date"
          class="text-xs mt-4 mb-4 text-text/50 dark:text-dk-text/50 whitespace-nowrap"
          >
          &nbsp;
          </p>
          </div>
          
          </div>
          
          <NavLinks class="mt-4" />
          <div
          class="mt-5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3"
          >
          <nav
          class="flex flex-wrap gap-2 text-[11px] flex-1"
          aria-label="Nickipedia sections"
          >
          {
            [
                ["#featured-picture", "Featured picture"],
                ["#rabbit-holes", "Rabbit holes"],
                ["#featured-article", "Featured article"],
                ["#highlights", "Cross-wiki highlights"],
                ["#worst-of-the-wiki", "Worst of the wiki"],
                ["#article-graph", "Article graph"],
                ["#tag-evolution", "Tag evolution"],
                ["#latest-news", "Latest news"],
                ["#growth-chart", "Growth chart"],
                ["#by-the-numbers", "By the numbers"],
                ["#wiki-playground", "API playground"],
                ["#github-activity", "GitHub activity"],
                ["#language-breakdown", "Languages"],
                ["#portals", "Portals"],
              ].map(([href, label]) => (
                <a
                  href={href}
                  class="px-2.5 py-1 rounded-full border border-text/15 dark:border-dk-text/20 text-text/60 dark:text-dk-text/60 hover:text-secondary dark:hover:text-dk-accent hover:border-secondary/40 dark:hover:border-dk-accent/40 transition-colors"
                >
                  {label}
                </a>
              ))
            }

            <button
              id="random-article-btn"
              type="button"
              class="text-xs font-semibold px-3 py-1.5 rounded-full border border-secondary/40 dark:border-dk-accent/40 text-secondary dark:text-dk-accent hover:bg-secondary/10 dark:hover:bg-dk-secondary/10 transition-colors"
            >
              🎲 Random page
            </button>
            <button
              id="recent-article-btn"
              type="button"
              class="text-xs font-semibold px-3 py-1.5 rounded-full border border-secondary/40 dark:border-dk-accent/40 text-secondary dark:text-dk-accent hover:bg-secondary/10 dark:hover:bg-dk-secondary/10 transition-colors"
            >
              🕓 Recent Post
            </button>
            <a
              href="https://www.buymeacoffee.com/nickstambaugh"
              type="button"
              class="text-xs font-semibold px-3 py-1.5 rounded-full border border-[#6F4E37]/40 dark:border-[#6F4E37]/60 text-[#6F4E37] dark:text-[#A67B5B] hover:bg-[#6F4E37]/10 transition-colors"
            >
              ☕ Buy Nick a coffee
            </a>
          </nav>

          <div class="relative w-full lg:w-80 xl:w-96 shrink-0 z-50">
            <input
              type="text"
              id="wiki-search-input"
              placeholder="Search everything (↑ and ↓ to navigate)..."
              autocomplete="off"
              class="w-full px-3 py-2 text-sm rounded-md border border-text/20 dark:border-dk-text/20 bg-secondary/5 dark:bg-dk-secondary/5 text-text dark:text-dk-text placeholder-text/40 dark:placeholder-dk-text/40 focus:outline-none focus:border-secondary dark:focus:border-dk-accent transition-colors"
            />
            <div
              id="wiki-search-results"
              class="absolute top-full left-0 right-0 mt-2 bg-primary dark:bg-dk-primary border border-secondary/20 dark:border-dk-accent/20 rounded-lg shadow-xl hidden flex-col max-h-96 overflow-y-auto"
            >
            </div>
          </div>
        </div>

        <div
          id="wiki-search-data"
          data-posts={JSON.stringify(unifiedSearchData)}
          class="hidden"
        >

          <script define:vars={{ wikipediaLinks }}>
            function renderRandomLinks(count = 10) {
              const container = document.getElementById("wiki-links-container");
              if (!container || !wikipediaLinks || wikipediaLinks.length === 0)
                return;
              const shuffled = [...wikipediaLinks];
              for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
              }
              const selected = shuffled.slice(0, count);
              container.innerHTML = selected
                .map(
                  (link) => `
                <li class="text-sm flex items-start gap-2.5">
                  <span class="wiki-thumb shrink-0 w-9 h-9 rounded-md bg-text/10 dark:bg-dk-text/10 overflow-hidden flex items-center justify-center text-[9px] text-text/30 dark:text-dk-text/30" data-title="${link.wikiTitle}" data-host="${link.wikiHost}">···</span>
                  <span class="min-w-0">
                    <a href="${link.url}" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent hover:underline underline-offset-4 font-medium">${link.label}</a>
                    <span class="text-text/40 dark:text-dk-text/40"> — from </span>
                    <a href="${link.postUrl}" class="text-text/60 dark:text-dk-text/60 hover:underline underline-offset-4">${link.postTitle}</a>
                  </span>
                </li>
              `,
                )
                .join("");
              loadWikiThumbnails();
            }

            function loadWikiThumbnails() {
              const thumbs = Array.from(
                document.querySelectorAll(".wiki-thumb:not([data-loaded])"),
              ).slice(0, 12);
              thumbs.forEach((el) => {
                el.setAttribute("data-loaded", "1");
                const title = el.getAttribute("data-title");
                const host = el.getAttribute("data-host") || "en.wikipedia.org";
                if (!title) return;
                fetch(`https://${host}/api/rest_v1/page/summary/${title}`)
                  .then((res) => (res.ok ? res.json() : null))
                  .then((data) => {
                    if (data && data.thumbnail && data.thumbnail.source) {
                      el.innerHTML = `<img src="${data.thumbnail.source}" alt="" class="w-full h-full object-cover" loading="lazy" />`;
                    } else {
                      el.textContent = "📄";
                    }
                  })
                  .catch(() => {
                    el.textContent = "📄";
                  });
              });
            }

            function setupWikiRabbitHoles() {
              const select = document.getElementById("wiki-count-select");
              if (select) {
                const count = parseInt(select.value, 10);
                renderRandomLinks(count);
                select.addEventListener("change", (e) => {
                  renderRandomLinks(parseInt(e.target.value, 10));
                });
              } else {
                renderRandomLinks();
              }
            }
            setupWikiRabbitHoles();
            document.addEventListener("astro:page-load", setupWikiRabbitHoles);
          </script>

          <script>
            function initFeaturedPicture() {
              const container = document.getElementById(
                "featured-picture-container",
              );
              const skeleton = document.getElementById(
                "featured-picture-skeleton",
              );
              const captionEl = document.getElementById(
                "featured-picture-caption",
              );
              if (!container || !captionEl) return;
              if (container.dataset.loaded === "true") return;
              container.dataset.loaded = "true";

              const now = new Date();
              const yyyy = now.getFullYear();
              const mm = String(now.getMonth() + 1).padStart(2, "0");
              const dd = String(now.getDate()).padStart(2, "0");

              fetch(
                `https://en.wikipedia.org/api/rest_v1/feed/featured/${yyyy}/${mm}/${dd}`,
              )
                .then((res) => res.json())
                .then((data) => {
                  const img = data.image;
                  if (img && img.thumbnail && img.thumbnail.source) {
                    skeleton?.remove();
                    const imgEl = document.createElement("img");
                    imgEl.src = img.thumbnail.source;
                    imgEl.alt =
                      (img.description && img.description.text) ||
                      "Wikipedia featured picture";
                    imgEl.loading = "lazy";
                    imgEl.className =
                      "w-full sm:w-52 rounded-lg object-cover shrink-0 border border-text/10 dark:border-dk-text/10";
                    container.prepend(imgEl);

                    const desc =
                      (img.description && img.description.text) ||
                      "No description available for today's picture.";
                    const pageUrl =
                      img.file_page ||
                      (img.title
                        ? `https://commons.wikimedia.org/wiki/${encodeURIComponent(img.title)}`
                        : null);
                    captionEl.innerHTML = `${desc}${
                      pageUrl
                        ? ` <a href="${pageUrl}" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">View on Wikimedia Commons →</a>`
                        : ""
                    }`;
                  } else {
                    skeleton?.remove();
                    captionEl.textContent =
                      "No featured picture available today.";
                  }
                })
                .catch(() => {
                  skeleton?.remove();
                  captionEl.textContent =
                    "Could not load today's featured picture.";
                });
            }
            initFeaturedPicture();
            document.addEventListener("astro:page-load", initFeaturedPicture);
          </script>


          <script define:vars={{ didYouKnow }}>
            function initWidgets() {
              const dykEl = document.getElementById("dyk-container");
              if (dykEl && didYouKnow.length > 0) {
                const randomFact =
                  didYouKnow[Math.floor(Math.random() * didYouKnow.length)];
                dykEl.innerHTML = randomFact;
              }


              const otdEl = document.getElementById("on-this-day-container");
              if (otdEl) {
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");

                fetch(
                  `https://en.wikipedia.org/api/rest_v1/feed/onthisday/selected/${month}/${day}`,
                )
                  .then((res) => res.json())
                  .then((data) => {
                    const picks = data.selected || [];
                    if (picks.length > 0) {
                      const pick =
                        picks[Math.floor(Math.random() * picks.length)];
                      otdEl.innerHTML = `
                        <p class="text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                          <span class="font-semibold text-secondary dark:text-dk-accent">${pick.year}</span> — ${pick.text}
                        </p>
                        ${
                          pick.pages?.[0]?.content_urls?.desktop?.page
                            ? `
                          <p class="mt-2">
                            <a
                              href="${pick.pages[0].content_urls.desktop.page}"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-xs font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4"
                            >
                              Read on Wikipedia →
                            </a>
                          </p>
                        `
                            : ""
                        }
                      `;
                    } else {
                      otdEl.innerHTML = `<p class="text-sm text-text/60 dark:text-dk-text/60">No events found for today.</p>`;
                    }
                  })
                  .catch(() => {
                    otdEl.innerHTML = `<p class="text-sm text-text/60 dark:text-dk-text/60">Could not load historical events.</p>`;
                  });
              }
            }

            initWidgets();
            document.addEventListener("astro:page-load", initWidgets);

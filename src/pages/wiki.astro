                  class="w-full px-2.5 py-1.5 text-xs rounded-md border border-text/20 dark:border-dk-text/20 bg-primary dark:bg-dk-primary text-text dark:text-dk-text placeholder-text/40 dark:placeholder-dk-text/40 focus:outline-none focus:border-secondary dark:focus:border-dk-accent transition-colors"
                />
                <div id="playground-lookup-result" class="mt-2 min-h-[64px]">
                  <p class="text-xs text-text/50 dark:text-dk-text/50">
                    Search any topic for a live summary.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <script>
            function initWikiPlayground() {
              const randomBtn = document.getElementById(
                "playground-random-btn",
              );
              const randomResult = document.getElementById(
                "playground-random-result",
              );
              if (randomBtn && randomResult && !randomBtn.dataset.bound) {
                randomBtn.dataset.bound = "true";
                randomBtn.addEventListener("click", () => {
                  randomResult.innerHTML = `<p class="text-xs text-text/50 dark:text-dk-text/50">Loading…</p>`;
                  fetch("https://en.wikipedia.org/api/rest_v1/page/random/summary")
                    .then((res) => (res.ok ? res.json() : Promise.reject()))
                    .then((data) => {
                      randomResult.innerHTML = `
                        ${data.thumbnail?.source ? `<img src="${data.thumbnail.source}" class="w-14 h-14 rounded object-cover shrink-0" alt="" loading="lazy" />` : ""}
                        <span class="min-w-0">
                          <a href="${data.content_urls?.desktop?.page ?? "#"}" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-secondary dark:text-dk-accent hover:underline underline-offset-4">${data.title ?? "Untitled"}</a>
                          <p class="text-xs text-text/60 dark:text-dk-text/60 mt-0.5">${data.extract ?? ""}</p>
                        </span>
                      `;
                    })
                    .catch(() => {
                      randomResult.innerHTML = `<p class="text-xs text-text/50 dark:text-dk-text/50">Couldn't load a random article. Try again.</p>`;
                    });
                });
              }

              const lookupInput = document.getElementById(
                "playground-lookup-input",
              );
              const lookupResult = document.getElementById(
                "playground-lookup-result",
              );
              if (lookupInput && lookupResult && !lookupInput.dataset.bound) {
                lookupInput.dataset.bound = "true";
                let debounce;
                lookupInput.addEventListener("input", (e) => {
                  clearTimeout(debounce);
                  const q = e.target.value.trim();
                  if (!q) {
                    lookupResult.innerHTML = `<p class="text-xs text-text/50 dark:text-dk-text/50">Search any topic for a live summary.</p>`;
                    return;
                  }
                  debounce = setTimeout(() => {
                    lookupResult.innerHTML = `<p class="text-xs text-text/50 dark:text-dk-text/50">Loading…</p>`;
                    fetch(
                      `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(q)}`,
                    )
                      .then((res) => (res.ok ? res.json() : Promise.reject()))
                      .then((data) => {
                        lookupResult.innerHTML = `
                          <div class="flex gap-3 items-start">
                            ${data.thumbnail?.source ? `<img src="${data.thumbnail.source}" class="w-14 h-14 rounded object-cover shrink-0" alt="" loading="lazy" />` : ""}
                            <span class="min-w-0">
                              <a href="${data.content_urls?.desktop?.page ?? "#"}" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-secondary dark:text-dk-accent hover:underline underline-offset-4">${data.title ?? "Untitled"}</a>
                              <p class="text-xs text-text/60 dark:text-dk-text/60 mt-0.5">${data.extract ?? ""}</p>
                            </span>
                          </div>
                        `;
                      })
                      .catch(() => {
                        lookupResult.innerHTML = `<p class="text-xs text-text/50 dark:text-dk-text/50">No article found.</p>`;
                      });
                  }, 500);
                });
              }
            }
            initWikiPlayground();
            document.addEventListener("astro:page-load", initWikiPlayground);
          </script>


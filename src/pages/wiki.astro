                  {info.name}
                </dd>
              </div>
            </dl>
          </section>

          <section
            class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5"
          >
            <h2
              class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3"
            >
              Top Categories
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {
                topTags.map((tag) => (
                  <a
                    href={`/posts?tag=${tag.key}`}
                    class="text-[11px] px-2 py-1 rounded-full border border-text/20 dark:border-dk-text/20 text-text/70 dark:text-dk-text/70 hover:text-secondary dark:hover:text-dk-accent hover:border-secondary/40 dark:hover:border-dk-accent/40 transition-colors"
                  >
                    {tag.label}{" "}
                    <span class="text-text/40 dark:text-dk-text/40">
                      ({tag.count})
                    </span>
                  </a>
                ))
              }
            </div>
            <p class="mt-3">
              <a
                href="/tags"
                class="text-sm font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4"
              >
                All categories →
              </a>
            </p>
          </section>
          <ProtonAdAstroComponent />
        </aside>
      </div>
      
      <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
        <a
          href="/"
          class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
        >
          ← Back to home
        </a>
      </footer>
    </main>
  </div>

  <script>
    function updateWikiDate() {
      const el = document.getElementById("wiki-date");
      if (!el) return;
      const now = new Date();
      el.textContent = now.toLocaleDateString("en-US", {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric",
      });
    }
    updateWikiDate();
    document.addEventListener("astro:page-load", updateWikiDate);
  </script>

  <script define:vars={{ randomArticles }}>
    function setupRandomArticle() {
      const btn = document.getElementById("random-article-btn");
      if (!btn || btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        if (!randomArticles || randomArticles.length === 0) return;
        const pick =
          randomArticles[Math.floor(Math.random() * randomArticles.length)];
        window.location.href = pick.url;
      });
    }
    setupRandomArticle();
    document.addEventListener("astro:page-load", setupRandomArticle);
  </script>
  <script define:vars={{ featured }}>
    function setupRecentArticle() {
      const btn = document.getElementById("recent-article-btn");
      if (!btn || btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        if (!featured || featured.length === 0) return; //featured ya boi
        const pick = featured;
        window.location.href = pick.url;
      });
    }
    setupRecentArticle();
    document.addEventListener("astro:page-load", setupRecentArticle);
  </script>
</BaseLayout>

<script>
  // @ts-nocheck
  import Fuse from "fuse.js";

  function setupWikiSearch() {
    const dataEl = document.getElementById("wiki-search-data");
    const input = document.getElementById("wiki-search-input");
    const resultsContainer = document.getElementById("wiki-search-results");

    if (!dataEl || !input || !resultsContainer) return;

    if (input.dataset.searchLoaded === "true") return;
    input.dataset.searchLoaded = "true";

    const items = JSON.parse(dataEl.dataset.posts);
    const fuse = new Fuse(items, {
      keys: ["title", "description"],
      threshold: 0.3,
    });

    let selectedIndex = -1;
    let currentResults = [];

    function renderResults() {
      if (currentResults.length === 0) {
        resultsContainer.classList.add("hidden");
        resultsContainer.innerHTML = "";
        return;
      }

      resultsContainer.classList.remove("hidden");
      resultsContainer.innerHTML = currentResults
        .map(
          (res, i) => `
        <a href="${res.item.url}" ${res.item.url && res.item.url.startsWith("http") ? 'target="_blank" rel="noopener noreferrer"' : ""} class="block p-3 border-b border-text/10 dark:border-dk-text/10 last:border-0 hover:bg-secondary/10 dark:hover:bg-dk-secondary/20 transition-colors ${i === selectedIndex ? "bg-secondary/10 dark:bg-dk-secondary/20" : ""}">
          <div class="flex justify-between items-center gap-2">
            <h3 class="text-sm font-bold text-text dark:text-dk-text truncate">${res.item.title}</h3>
            <span class="shrink-0 text-[9px] uppercase tracking-wide px-1.5 py-0.5 rounded-full border border-text/20 dark:border-dk-text/20 text-text/50 dark:text-dk-text/50">${res.item.type}</span>
          </div>
          <p class="text-xs text-text/70 dark:text-dk-text/70 truncate mt-0.5">${res.item.description || ""}</p>
        </a>
      `,
        )
        .join("");
    }

    input.addEventListener("input", (e) => {
      const q = e.target.value;
      if (!q.trim()) {
        currentResults = [];
        selectedIndex = -1;
        renderResults();
        return;
      }
      currentResults = fuse.search(q).slice(0, 6);
      selectedIndex = currentResults.length > 0 ? 0 : -1;
      renderResults();
    });

    input.addEventListener("keydown", (e) => {
      if (currentResults.length === 0) {
        if (e.key === "Enter" && e.target.value.trim() !== "") {
          e.preventDefault();
          window.location.href = `/posts?q=${encodeURIComponent(e.target.value)}`;
        }
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIndex =
          selectedIndex < currentResults.length - 1 ? selectedIndex + 1 : 0;
        renderResults();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIndex =
          selectedIndex > 0 ? selectedIndex - 1 : currentResults.length - 1;
        renderResults();
      } else if (e.key === "Enter" && selectedIndex >= 0) {
        e.preventDefault();
        window.location.href = currentResults[selectedIndex].item.url;
      } else if (e.key === "Escape") {
        currentResults = [];
        renderResults();
        input.blur();
      }
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !resultsContainer.contains(e.target)) {
        currentResults = [];
        renderResults();
      }
    });
  }

  document.addEventListener("astro:page-load", setupWikiSearch);

  function initTopRated() {
    const data = document.getElementById("top-rated-data");
    if (!data) return;

    const books = JSON.parse(data.dataset.books || "[]");
    const media = JSON.parse(data.dataset.media || "[]");

    if (books.length) {
      const book = books[Math.floor(Math.random() * books.length)];

      document.getElementById("top-book-card").href =
        `/library?book=${book.id}`;
      document.getElementById("top-book-title").textContent = book.title;
      document.getElementById("top-book-meta").textContent =
        `${book.author} · ${book.rating}/5 ★`;
    }

    if (media.length) {
      const item = media[Math.floor(Math.random() * media.length)];

      document.getElementById("top-media-card").href = `/media?item=${item.id}`;
      document.getElementById("top-media-title").textContent = item.title;
      document.getElementById("top-media-meta").textContent =
        `${item.creator} · ${item.rating}/5 ★`;
    }
  }

  initTopRated();
  setupWikiSearch();
  document.addEventListener("astro:page-load", initTopRated);
</script>

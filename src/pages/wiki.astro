---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";

const allPosts = await Astro.glob("./posts/*.md");

const sortedPosts = [...allPosts].sort((a, b) => {
  const A = new Date(a.frontmatter.date).getTime();
  const B = new Date(b.frontmatter.date).getTime();
  return (isNaN(B) ? 0 : B) - (isNaN(A) ? 0 : A);
});

// Prepare payloads for client-side use
const searchData = allPosts.map(post => ({
  title: post.frontmatter.title || "Untitled",
  description: post.frontmatter.description || "",
  url: post.url
}));

const featured = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 6);
const totalPosts = allPosts.length;
const today = new Date();

let githubStats = {
  topRepo: "simple-chat-csharp",
  stars: 27,
  publicRepos: null as number | null,
};

try {
  const ghRes = await fetch(
    "https://api.github.com/users/Sieep-Coding/repos?per_page=100&sort=updated"
  );
  if (ghRes.ok) {
    const repos = await ghRes.json();
    if (Array.isArray(repos) && repos.length) {
      const top = [...repos].sort(
        (a, b) => (b.stargazers_count ?? 0) - (a.stargazers_count ?? 0)
      )[0];
      githubStats = {
        topRepo: top.name,
        stars: top.stargazers_count ?? 0,
        publicRepos: repos.length,
      };
    }
  }
} catch (err) {}

const wikipediaLinksMap = new Map<
  string,
  {
    label: string;
    url: string;
    postTitle: string;
    postUrl: string;
  }
>();

const wikiHrefPattern =
  /href="(https?:\/\/(?:[a-z]{2,3}\.)?wikipedia\.org\/wiki\/[^"]+)"/gi;

for (const post of allPosts) {
  let html = "";
  try {
    html = await post.compiledContent();
  } catch (err) {
    continue;
  }
  let found = 0;
  for (const match of html.matchAll(wikiHrefPattern)) {
    const url = match[1];
    const decoded = decodeURIComponent(
      url
        .split("/wiki/")
        .pop()
        ?.replaceAll("_", " ") ?? "Wikipedia"
    );
    found++;
    if (!wikipediaLinksMap.has(url)) {
      wikipediaLinksMap.set(url, {
        label: decoded,
        url,
        postTitle: post.frontmatter.title,
        postUrl: post.url,
      });
    }
  }
}

const wikipediaLinks = Array.from(wikipediaLinksMap.values());

// Defined array passed safely to client-side scripts via JSON
const didYouKnow = [
  `...that Nick's degrees are in <a href="/about" class="text-secondary dark:text-dk-accent underline underline-offset-4">economics and philosophy</a>, not computer science?`,
  `...that Nick's most-starred repo on GitHub is <a href="https://github.com/Sieep-Coding/${githubStats.topRepo}" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">${githubStats.topRepo}</a>, with ${githubStats.stars} stars?`,
  `...that Nick's dog <a href="/bruce-the-dog" class="text-secondary dark:text-dk-accent underline underline-offset-4">Bruce</a> is a Norwegian Elkhound mixed with a Schipperke?`,
  `...that Nick produces music under the name <a href="/music" class="text-secondary dark:text-dk-accent underline underline-offset-4">sieep</a>, made in FL Studio?`,
  `...that Nick's rating scale for <a href="/library" class="text-secondary dark:text-dk-accent underline underline-offset-4">books</a> and <a href="/media" class="text-secondary dark:text-dk-accent underline underline-offset-4">media</a> goes up to 5 stars, half-stars included?`,
  `...that Nick's blog spans <a href="/tags" class="text-secondary dark:text-dk-accent underline underline-offset-4">10+ topics</a>, from nuclear economics to old comic books?`,
  `...that Nick founded <a href="https://luniv.tech" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">Luniv Technology</a>, his own custom software and BI shop?`,
  `...that before software, Nick wrote a <a href="/posts/making-nuclear-energy-competitve-with-fossil-fuels-and-natural-gas" class="text-secondary dark:text-dk-accent underline underline-offset-4">report on nuclear reactor economics</a> for Michigan's NERS department?`,
  `...that Nick has written up trips to <a href="/posts/chicago" class="text-secondary dark:text-dk-accent underline underline-offset-4">Chicago</a> and <a href="/posts/houston" class="text-secondary dark:text-dk-accent underline underline-offset-4">Houston</a>?`,
  `...that Nick has strong opinions about <a href="/posts/my-thoughts-on-soccer" class="text-secondary dark:text-dk-accent underline underline-offset-4">football</a> — the kind played with your feet?`,
  `...that this site runs ad-free, but you can <a href="https://www.buymeacoffee.com/nickstambaugh" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">buy him a coffee</a> anyway?`,
  `...that the site itself is hand-coded in <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent underline underline-offset-4">Astro</a>, React, and TypeScript?`,
];

const tagMap = new Map();
for (const post of allPosts) {
  const postTags = post.frontmatter.tags || [];
  for (const raw of postTags) {
    const key = raw
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-");
    if (!key) continue;
    const label = raw.replace(/^#/, "");
    const existing = tagMap.get(key);
    if (existing) existing.count += 1;
    else tagMap.set(key, { label, count: 1 });
  }
}
const topTags = Array.from(tagMap.entries())
  .map(([key, v]) => ({ key, ...v }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

const dateStr = today.toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const portals = [
  { href: "/posts", label: "Posts", desc: `${totalPosts} articles`, icon: "📝" },
  { href: "/music", label: "Music", desc: "sieep, instrumentals", icon: "🎵" },
  { href: "/recipes", label: "Recipes", desc: "Cooking archive", icon: "🍳" },
  { href: "/library", label: "Library", desc: "Books read", icon: "📚" },
  { href: "/media", label: "Media", desc: "Movies, shows, games", icon: "🎬" },
  { href: "/projects", label: "Projects", desc: "Client & open source", icon: "🛠️" },
  { href: "/bruce-the-dog", label: "Bruce", desc: "The dog", icon: "🐕" },
  { href: "/about", label: "About", desc: "Nick Stambaugh", icon: "👤" },
];
---
<BaseLayout title="Nickipedia — The Stambaugh Wiki">
  <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen">
    <main class="max-w-[1400px] mx-auto px-4 sm:px-8 pt-28 pb-10 sm:pt-32 sm:pb-16">
      <header class="border-b-4 border-secondary/20 dark:border-dk-accent/20 pb-4 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <div>
            <h1
              class="text-4xl sm:text-5xl font-serif font-bold tracking-tight text-secondary dark:text-dk-accent"
            >
              Nickipedia
            </h1>
            <p class="text-sm italic text-text/60 dark:text-dk-text/60 mt-1">
              Version 0.1
            </p>
          </div>
          <p class="text-xs text-text/50 dark:text-dk-text/50">{dateStr}</p>
          
          <!-- Inline Wiki Search -->
          <div class="mt-5 relative w-full max-w-md z-50">
            <input
              type="text"
              id="wiki-search-input"
              placeholder="Search blog (&uarr; and &darr; to navigate)..."
              autocomplete="off"
              class="w-full px-3 py-2 text-sm rounded-md border border-text/20 dark:border-dk-text/20 bg-secondary/5 dark:bg-dk-secondary/5 text-text dark:text-dk-text placeholder-text/40 dark:placeholder-dk-text/40 focus:outline-none focus:border-secondary dark:focus:border-dk-accent transition-colors"
            />
            <div
              id="wiki-search-results"
              class="absolute top-full left-0 right-0 mt-2 bg-primary dark:bg-dk-primary border border-secondary/20 dark:border-dk-accent/20 rounded-lg shadow-xl hidden flex-col max-h-96 overflow-y-auto"
            ></div>
          </div>
          <div id="wiki-search-data" data-posts={JSON.stringify(searchData)} class="hidden"></div>

        </div>
      </header>
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3 space-y-8">
            {wikipediaLinks.length > 0 && (
              <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6">
                <div class="flex items-center justify-between border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
                  <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent">
                    Wikipedia Rabbit Holes
                  </h2>
                  <select
                    id="wiki-count-select"
                    class="text-xs bg-transparent border border-text/20 dark:border-dk-text/20 rounded px-2 py-1 text-text dark:text-dk-text focus:outline-none focus:border-secondary dark:focus:border-dk-accent cursor-pointer transition-colors"
                  >
                    <option value="5" class="bg-secondary/5 dark:bg-dk-secondary/10">Show 5</option>
                    <option value="10" selected class="bg-secondary/5 dark:bg-dk-secondary/10">Show 10</option>
                    <option value="15" class="bg-secondary/5 dark:bg-dk-secondary/10">Show 15</option>
                    <option value="20" class="bg-secondary/5 dark:bg-dk-secondary/10">Show 20</option>
                  </select>
                </div>
                <p class="text-xs text-text/50 dark:text-dk-text/50 mb-3">
                  Randomized Wikipedia links scraped from Nick's blog.
                </p>
                
                <ul id="wiki-links-container" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
                  {wikipediaLinks.slice(0, 10).map((link) => (
                    <li class="text-sm"><a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-secondary dark:text-dk-accent hover:underline underline-offset-4 font-medium"
                      >{link.label}</a>
                      <span class="text-text/40 dark:text-dk-text/40"> from </span>
                      <a
                        href={link.postUrl}
                        class="text-text/60 dark:text-dk-text/60 hover:underline underline-offset-4"
                      >{link.postTitle}</a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          {featured && (
            <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6">
              <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
                Featured Article
              </h2>
              <a
                href={featured.url}
                class="text-xl font-serif font-semibold text-secondary dark:text-dk-accent hover:underline underline-offset-4"
              >
                {featured.frontmatter.title}
              </a>
              {featured.frontmatter.description && (
                <p class="mt-2 text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                  {featured.frontmatter.description}
                </p>
              )}
              <p class="mt-3">
                <a
                  href={featured.url}
                  class="text-sm font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4"
                >
                  Read full article →
                </a>
              </p>
            </section>
          )}
          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
              Nick's Latest News
            </h2>
            <ul class="space-y-2.5">
              {recentPosts.map((post) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-text/30 dark:text-dk-text/30 mt-0.5">•</span>
                  <a
                    href={post.url}
                    class="text-text dark:text-dk-text hover:text-secondary dark:hover:text-dk-accent hover:underline underline-offset-4 transition-colors"
                  >
                    {post.frontmatter.title}
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-3">
              <a href="/posts" class="text-sm font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4">
                View all posts →
              </a>
            </p>
          </section>

          <script define:vars={{ wikipediaLinks }}>
            function renderRandomLinks(count = 10) {
              const container = document.getElementById("wiki-links-container");
              if (!container || !wikipediaLinks || wikipediaLinks.length === 0) return;
              const shuffled = [...wikipediaLinks];
              for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
              }
              const selected = shuffled.slice(0, count);
              container.innerHTML = selected.map(link => `
                <li class="text-sm">
                  <a href="${link.url}" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-dk-accent hover:underline underline-offset-4 font-medium">${link.label}</a>
                  <span class="text-text/40 dark:text-dk-text/40"> — from </span>
                  <a href="${link.postUrl}" class="text-text/60 dark:text-dk-text/60 hover:underline underline-offset-4">${link.postTitle}</a>
                </li>
              `).join('');
            }

            function setupWikiRabbitHoles() {
              const select = document.getElementById("wiki-count-select");
              if (select) {
                const count = parseInt(select.value, 10);
                renderRandomLinks(count);
                select.addEventListener("change", (e) => {
                  renderRandomLinks(parseInt(e.target.value, 10));
                });
              } else {
                renderRandomLinks();
              }
            }
            setupWikiRabbitHoles();
            document.addEventListener('astro:page-load', setupWikiRabbitHoles);
          </script>

          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5 sm:p-6">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-4">
              Other Areas of This Site
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {portals.map((p) => (
                <a
                  href={p.href}
                  class="group flex flex-col items-center text-center gap-1 p-3 rounded-lg border border-text/10 dark:border-dk-text/10 hover:bg-secondary/10 dark:hover:bg-dk-secondary/10 transition-colors"
                >
                  <span class="text-2xl">{p.icon}</span>
                  <span class="text-sm font-medium text-secondary dark:text-dk-accent group-hover:underline underline-offset-4">
                    {p.label}
                  </span>
                  <span class="text-[11px] text-text/50 dark:text-dk-text/50">
                    {p.desc}
                  </span>
                </a>
              ))}
            </div>
          </section>
        </div>

        <aside class="space-y-8">
          <!-- Client-side "Did You Know?" -->
          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
              Did You Know?
            </h2>
            <p
              id="dyk-container"
              class="text-sm text-text/80 dark:text-dk-text/80 leading-relaxed"
            >
              Loading...
            </p>
          </section>

          <!-- Client-side "On This Day" -->
          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
              On This Day
            </h2>
            <div id="on-this-day-container">
              <p class="text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">Loading...</p>
            </div>
            <p class="mt-2 text-[10px] text-text/40 dark:text-dk-text/40">
              Live from the Wikipedia REST API.
            </p>
          </section>

          <script define:vars={{ didYouKnow }}>
            function initWidgets() {
              // 1. Randomize "Did You Know?"
              const dykEl = document.getElementById("dyk-container");
              if (dykEl && didYouKnow.length > 0) {
                const randomFact = didYouKnow[Math.floor(Math.random() * didYouKnow.length)];
                dykEl.innerHTML = randomFact;
              }

              // 2. Fetch fresh random "On This Day" entry
              const otdEl = document.getElementById("on-this-day-container");
              if (otdEl) {
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");

                fetch(`https://en.wikipedia.org/api/rest_v1/feed/onthisday/selected/${month}/${day}`)
                  .then(res => res.json())
                  .then(data => {
                    const picks = data.selected || [];
                    if (picks.length > 0) {
                      const pick = picks[Math.floor(Math.random() * picks.length)];
                      otdEl.innerHTML = `
                        <p class="text-sm text-text/80 dark:text-dk-text/80 leading-relaxed">
                          <span class="font-semibold text-secondary dark:text-dk-accent">${pick.year}</span> — ${pick.text}
                        </p>
                        ${pick.pages?.[0]?.content_urls?.desktop?.page ? `
                          <p class="mt-2">
                            <a
                              href="${pick.pages[0].content_urls.desktop.page}"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-xs font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4"
                            >
                              Read on Wikipedia →
                            </a>
                          </p>
                        ` : ''}
                      `;
                    } else {
                      otdEl.innerHTML = `<p class="text-sm text-text/60 dark:text-dk-text/60">No events found for today.</p>`;
                    }
                  })
                  .catch(() => {
                    otdEl.innerHTML = `<p class="text-sm text-text/60 dark:text-dk-text/60">Could not load historical events.</p>`;
                  });
              }
            }

            initWidgets();
            document.addEventListener('astro:page-load', initWidgets);
          </script>

          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
              Wiki Stats
            </h2>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-text/60 dark:text-dk-text/60">Articles</dt>
                <dd class="font-medium text-text dark:text-dk-text tabular-nums">{totalPosts}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-text/60 dark:text-dk-text/60">Categories</dt>
                <dd class="font-medium text-text dark:text-dk-text tabular-nums">{tagMap.size}</dd>
              </div>
              {githubStats.publicRepos !== null && (
                <div class="flex justify-between">
                  <dt class="text-text/60 dark:text-dk-text/60">Public repos</dt>
                  <dd class="font-medium text-text dark:text-dk-text tabular-nums">{githubStats.publicRepos}</dd>
                </div>
              )}
              <div class="flex justify-between">
                <dt class="text-text/60 dark:text-dk-text/60">Programmer</dt>
                <dd class="font-medium text-text dark:text-dk-text">{info.name}</dd>
              </div>
            </dl>
          </section>

          <section class="border border-text/10 dark:border-dk-text/10 rounded-xl bg-secondary/5 dark:bg-dk-secondary/5 p-5">
            <h2 class="text-xs font-bold uppercase tracking-widest text-secondary dark:text-dk-accent border-b border-text/10 dark:border-dk-text/10 pb-2 mb-3">
              Top Categories
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {topTags.map((tag) => (
                <a
                  href={`/posts?tag=${tag.key}`}
                  class="text-[11px] px-2 py-1 rounded-full border border-text/20 dark:border-dk-text/20 text-text/70 dark:text-dk-text/70 hover:text-secondary dark:hover:text-dk-accent hover:border-secondary/40 dark:hover:border-dk-accent/40 transition-colors"
                >
                  {tag.label} <span class="text-text/40 dark:text-dk-text/40">({tag.count})</span>
                </a>
              ))}
            </div>
            <p class="mt-3">
              <a href="/tags" class="text-sm font-medium text-secondary dark:text-dk-accent hover:underline underline-offset-4">
                All categories →
              </a>
            </p>
          </section>
        </aside>
      </div>

      <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
        <a href="/" class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors">
          ← Back to home
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  import Fuse from "fuse.js";

  function setupWikiSearch() {
    const dataEl = document.getElementById("wiki-search-data");
    const input = document.getElementById("wiki-search-input");
    const resultsContainer = document.getElementById("wiki-search-results");

    if (!dataEl || !input || !resultsContainer) return;

    if (input.dataset.searchLoaded === "true") return;
    input.dataset.searchLoaded = "true";

    const posts = JSON.parse(dataEl.dataset.posts);
    const fuse = new Fuse(posts, {
      keys: ["title", "description"],
      threshold: 0.3
    });

    let selectedIndex = -1;
    let currentResults = [];

    function renderResults() {
      if (currentResults.length === 0) {
        resultsContainer.classList.add("hidden");
        resultsContainer.innerHTML = "";
        return;
      }

      resultsContainer.classList.remove("hidden");
      resultsContainer.innerHTML = currentResults.map((res, i) => `
        <a href="${res.item.url}" class="block p-3 border-b border-text/10 dark:border-dk-text/10 last:border-0 hover:bg-secondary/10 dark:hover:bg-dk-secondary/20 transition-colors ${i === selectedIndex ? 'bg-secondary/10 dark:bg-dk-secondary/20' : ''}">
          <div class="flex justify-between items-center">
            <h3 class="text-sm font-bold text-text dark:text-dk-text">${res.item.title}</h3>
            ${i === selectedIndex ? '<span class="text-accent dark:text-dk-accent text-xs">↵</span>' : ''}
          </div>
          <p class="text-xs text-text/70 dark:text-dk-text/70 truncate mt-0.5">${res.item.description || ''}</p>
        </a>
      `).join("");
    }

    input.addEventListener("input", (e) => {
      const q = e.target.value;
      if (!q.trim()) {
        currentResults = [];
        selectedIndex = -1;
        renderResults();
        return;
      }
      currentResults = fuse.search(q).slice(0, 5);
      selectedIndex = currentResults.length > 0 ? 0 : -1;
      renderResults();
    });

    input.addEventListener("keydown", (e) => {
      if (currentResults.length === 0) {
        if (e.key === "Enter" && e.target.value.trim() !== "") {
            e.preventDefault();
            window.location.href = `/posts?q=${encodeURIComponent(e.target.value)}`;
        }
        return;
      }
      
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIndex = selectedIndex < currentResults.length - 1 ? selectedIndex + 1 : 0;
        renderResults();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIndex = selectedIndex > 0 ? selectedIndex - 1 : currentResults.length - 1;
        renderResults();
      } else if (e.key === "Enter" && selectedIndex >= 0) {
        e.preventDefault();
        window.location.href = currentResults[selectedIndex].item.url;
      } else if (e.key === "Escape") {
        currentResults = [];
        renderResults();
        input.blur();
      }
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !resultsContainer.contains(e.target)) {
        currentResults = [];
        renderResults();
      }
    });
  }

  setupWikiSearch();
  document.addEventListener("astro:page-load", setupWikiSearch);
</script>
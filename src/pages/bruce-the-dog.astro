---
import BaseLayout from "../layouts/BaseLayout.astro";

const photos = [
  { src: "/bruce/bruce1.jpg"  },
  { src: "/bruce/bruce2.jpg"  },
  { src: "/bruce/bruce3.jpg"   },
  { src: "/bruce/bruce4.jpg"   },
  { src: "/bruce/bruce5.jpg"  },
  { src: "/bruce/bruce6.jpg" },
  { src: "/bruce/bruce7.jpg" },
];
---

<BaseLayout title="Bruce">
  <main class="max-w-2xl mx-auto px-4 py-16 sm:py-24">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {
        photos.map((photo, i) => (
          <button
            class="gallery-trigger group relative aspect-square overflow-hidden rounded-xl border border-text/10 dark:border-dk-text/10 bg-secondary/5 dark:bg-dk-secondary/5 focus:outline-none focus:ring-2 focus:ring-secondary dark:focus:ring-dk-accent"
            data-index={i}
          >
            <img
              src={photo.src}
              alt={photo.caption}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </button>
        ))
      }
    </div>

    <!-- Lightbox -->
    <div
      id="lightbox"
      class="hidden fixed inset-0 z-50 bg-black/90 items-center justify-center p-4"
    >
      <button
        id="lightbox-close"
        aria-label="Close"
        class="absolute top-4 right-4 text-white/70 hover:text-white text-2xl leading-none"
      >
        ✕
      </button>
      <button
        id="lightbox-prev"
        aria-label="Previous"
        class="absolute left-2 sm:left-6 text-white/70 hover:text-white text-3xl leading-none px-2"
      >
        ‹
      </button>
      <button
        id="lightbox-next"
        aria-label="Next"
        class="absolute right-2 sm:right-6 text-white/70 hover:text-white text-3xl leading-none px-2"
      >
        ›
      </button>
      <figure class="max-w-3xl max-h-[85vh] flex flex-col items-center gap-3">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[85vh] w-auto rounded-lg object-contain"
        />
      </figure>
    </div>

    <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
      <a
        href="/"
        class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
      >
        ← Back to home
      </a>
    </footer>
  </main>

  <script define:vars={{ photos }}>
    document.addEventListener("DOMContentLoaded", () => {
      const lightbox = document.getElementById("lightbox");
      const img = document.getElementById("lightbox-img");
      const triggers = Array.from(document.querySelectorAll(".gallery-trigger"));
      let current = 0;

      const open = (index) => {
        current = index;
        img.src = photos[current].src;
        img.alt = photos[current].caption;
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
      };

      const close = () => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
      };

      const show = (delta) => {
        current = (current + delta + photos.length) % photos.length;
        open(current);
      };

      triggers.forEach((btn) => {
        btn.addEventListener("click", () => open(Number(btn.dataset.index)));
      });

      document.getElementById("lightbox-close").addEventListener("click", close);
      document.getElementById("lightbox-prev").addEventListener("click", () => show(-1));
      document.getElementById("lightbox-next").addEventListener("click", () => show(1));

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) close();
      });

      document.addEventListener("keydown", (e) => {
        if (lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(-1);
        if (e.key === "ArrowRight") show(1);
      });
    });
  </script>
</BaseLayout>
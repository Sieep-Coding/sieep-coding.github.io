---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { info } from "../data/info";
import Contact from "../components/contact_section/Contact";
import ViewBlog from "../components/about_section/VisitBlog";
import RecentPosts from "../components/post_section/RecentBlogs";
import LinkPreview from "../components/post_section/LinkPreview.astro";
import Comments from "../components/post_section/Comments.astro";
import ProtonAdAstroComponent from "../components/about_section/ProtonAd.astro";

const { frontmatter } = Astro.props;
const rawPosts = await Astro.glob("../pages/posts/*.md");

const posts = rawPosts.map((post) => ({
  frontmatter: {
    title: post.frontmatter.title,
    date: post.frontmatter.date,
    description: post.frontmatter.description,
    tags: post.frontmatter.tags || [],
  },
  url: post.url || "",
}));

const { title, date, img_path, img_alt, tags } = frontmatter;
// Controls how in-article images are laid out:
// "float"  -> alternating left/right floats with text wrap (default)
// "stack"  -> traditional full-width, image-then-caption stacking
const imageLayout: "float" | "stack" = frontmatter.image_layout || "float";
const selectedTag = Astro.url.searchParams.get("selectedTag");

const filteredPosts = selectedTag
  ? posts.filter((post) => post.frontmatter.tags.includes(selectedTag))
  : posts;

const slug = (t: string) =>
  t
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, "")
    .replace(/[\s_-]+/g, "-");

const postTags: string[] = tags || [];
---

<script is:inline>
  // Wraps each in-article <img> (and its following blockquote caption, if any)
  // into a <figure> that floats left/right alternately, like a typical blog layout.
  function setupImageFloats(article) {
    if (article.dataset.floatsApplied === "true") return;

    // Respect the per-post layout choice set via data-image-layout
    if (article.dataset.imageLayout === "stack") {
      article.dataset.floatsApplied = "true";
      return;
    }

    const imgs = Array.from(article.querySelectorAll("img")).filter(
      (img) => !img.closest("figure")
    );

    let floatIndex = 0;
    imgs.forEach((img) => {
      const parent = img.parentElement; // usually the <p> wrapping the markdown image
      const figure = document.createElement("figure");

      // Per-image override: add {left} or {right} at the end of the markdown
      // alt text, e.g. ![Chicago skyline {right}](../photo/_chi1.jpg)
      // to pin a specific image's side instead of using the alternating default.
      let side;
      const overrideMatch = img.alt?.match(/\{(left|right)\}\s*$/i);
      if (overrideMatch) {
        side = overrideMatch[1].toLowerCase() === "left" ? "img-float-left" : "img-float-right";
        img.alt = img.alt.replace(/\s*\{(left|right)\}\s*$/i, "");
      } else {
        side = floatIndex % 2 === 0 ? "img-float-left" : "img-float-right";
        floatIndex++;
      }

      figure.className = `blog-img-figure ${side}`;

      // Move the image into the figure first
      figure.appendChild(img);

      // If the image's paragraph is now empty, check the next sibling for a
      // blockquote caption (the "> caption" markdown convention used in posts)
      let captionEl = null;
      if (parent && parent.tagName === "P" && parent.childNodes.length === 0) {
        const nextEl = parent.nextElementSibling;
        if (nextEl && nextEl.tagName === "BLOCKQUOTE") {
          captionEl = nextEl;
        }
      }

      if (captionEl) {
        const figcaption = document.createElement("figcaption");
        figcaption.innerHTML = captionEl.innerHTML;
        figure.appendChild(figcaption);
        captionEl.remove();
      }

      // Swap the figure into place, replacing the (now empty) paragraph
      if (parent && parent.tagName === "P") {
        parent.replaceWith(figure);
      } else if (parent) {
        parent.insertBefore(figure, img.nextSibling);
      }
    });

    article.dataset.floatsApplied = "true";
  }

  function setupArticleFeatures() {
    const article = document.getElementById("article");
    if (!article) return;

    setupImageFloats(article);

    const timeEl = document.getElementById("time");
    if (timeEl) {
      const text = article.textContent || "";
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      const minutes = Math.max(1, Math.ceil(words / 175));
      timeEl.textContent = String(minutes);
    }

    const tocList = document.getElementById("toc-list");
    if (tocList) {
      tocList.innerHTML = "";

      const headings = article.querySelectorAll("h2, h3");

      if (!headings.length) {
        tocList.innerHTML =
          '<p class="opacity-60 text-sm">No headings found.</p>';
        return;
      }

      headings.forEach((heading, index) => {
        if (!heading.id) {
          heading.id =
            heading.textContent
              ?.toLowerCase()
              .trim()
              .replace(/[^\w\s-]/g, "")
              .replace(/\s+/g, "-") || `heading-${index}`;
        }

        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || "";
        link.className = heading.tagName === "H2" ? "toc-link" : "toc-link-sub";

        tocList.appendChild(link);
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupArticleFeatures);
  } else {
    setupArticleFeatures();
  }

  document.addEventListener("astro:page-load", setupArticleFeatures);
  document.addEventListener("astro:after-swap", setupArticleFeatures);
</script>

<style>
  /* Alternating left/right floated images with captions, like a typical blog */
  #article :global(.blog-img-figure) {
    margin: 0.25rem 0 1rem 0;
    max-width: 45%;
  }

  #article :global(.blog-img-figure.img-float-left) {
    float: left;
    margin-right: 1.5rem;
  }

  #article :global(.blog-img-figure.img-float-right) {
    float: right;
    margin-left: 1.5rem;
  }

  #article :global(.blog-img-figure img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    display: block;
  }

  #article :global(.blog-img-figure figcaption) {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 0.35rem;
    line-height: 1.3;
  }

  /* Clear floats around headings so sections start clean */
  #article :global(h2),
  #article :global(h3) {
    clear: both;
  }

  /* Stack images full-width on small screens instead of floating */
  @media (max-width: 768px) {
    #article :global(.blog-img-figure) {
      float: none;
      max-width: 100%;
      margin: 1rem 0;
    }
  }

  /* When a post opts into "stack" layout, images render full-width,
     centered, with the caption underneath — the original behavior. */
  #article[data-image-layout="stack"] :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    display: block;
    margin: 1.5rem 0 0.25rem 0;
  }

  #article[data-image-layout="stack"] :global(blockquote) {
    margin-top: 0;
  }
</style>

<BaseLayout title={title}>
  <main class="pt-20 lg:pt-24 w-full max-w-7xl mx-auto px-4">
    <div class="mb-8 w-full">
      <h1
        class="text-3xl font-semibold lg:text-4xl text-[#202020] dark:text-[#7c8fd1] break-words"
      >
        {title}
      </h1>
      <div
        class="flex flex-col lg:flex-row lg:items-center lg:justify-between mt-4"
      >
        <p class="text-sm lg:text-base text-[#202020] dark:text-[#96a6e2]">
          <span id="time" class="font-bold"></span> min read
        </p>
        <p
          class="text-sm lg:text-base flex gap-2 text-[#202020] dark:text-[#96a6e2]"
        >
          <span>{date}</span>
          <a href="/posts" class="ml-2 hover:underline">Back to posts</a>
        </p>
      </div>

      {
        img_path && (
          <Image
            src={img_path}
            alt={img_alt || title}
            class="w-full object-cover rounded lg:rounded-lg h-64 lg:h-96 mt-6"
            width={800}
            height={400}
          />
        )
      }

      <h2
        class="text-md lg:text-lg mt-4 opacity-80 text-[#202020] dark:text-[#7c8fd1]"
      >
        {frontmatter.description || "An insightful blog post."}
      </h2>
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      {
        postTags.map((tag) => (
          <a
            href={`/posts?tag=${slug(tag)}`}
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium lowercase border border-[#202020]/20 dark:border-[#7c8fd1]/30 text-[#202020] dark:text-[#96a6e2] hover:bg-[#202020]/5 dark:hover:bg-[#7c8fd1]/10 hover:border-[#202020]/40 dark:hover:border-[#7c8fd1]/50 transition-colors"
          >
            {tag.replace(/^#/, "")}
          </a>
        ))
      }
      <a
        href="/tags"
        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium lowercase border border-[#202020]/20 dark:border-[#7c8fd1]/30 text-[#202020] dark:text-[#96a6e2] hover:bg-[#202020]/5 dark:hover:bg-[#7c8fd1]/10 hover:border-[#202020]/40 dark:hover:border-[#7c8fd1]/50 transition-colors"
      >
        All Tags
      </a>
    </div>

    <div
      class="mb-12 border-y border-[#202020]/10 dark:border-[#7c8fd1]/20 py-4"
    >
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-semibold text-[#202020] dark:text-[#7c8fd1]"
          >Share</span
        >
        <a
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
          ><i class="fab fa-x-twitter"></i> X</a
        >
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
          ><i class="fab fa-facebook"></i> Facebook</a
        >
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
          ><i class="fab fa-linkedin"></i> LinkedIn</a
        >
        <a
          href={`https://www.reddit.com/submit?url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
          ><i class="fab fa-reddit"></i> Reddit</a
        >
        <a
          href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(Astro.url.href)}`}
          class="inline-flex items-center gap-2 text-sm hover:underline"
          ><i class="fas fa-envelope"></i> Email</a
        >
        <button
          type="button"
          onclick="navigator.clipboard.writeText(window.location.href)"
          class="inline-flex items-center gap-2 text-sm text-[#202020] dark:text-[#96a6e2] hover:underline"
          ><i class="fas fa-link"></i> Copy Link</button
        >
      </div>
    </div>
    <details
      class="mb-8 w-full rounded-lg border border-[#202020]/15 dark:border-[#7c8fd1]/30 bg-[#f9f6f230] dark:bg-[#111827] overflow-hidden group"
    >
      <summary
        class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-[#202020] dark:text-[#7c8fd1]"
      >
        <span>Table of Contents</span>
        <svg
          class="h-4 w-4 transition-transform duration-300 group-open:rotate-180"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>
      <div
        class="border-t border-[#202020]/10 dark:border-[#7c8fd1]/20 px-5 py-4"
      >
        <nav
          id="toc-list"
          class="flex flex-col text-[#202020] dark:text-[#96a6e2]"
        >
        </nav>
      </div>
    </details>
    <div class="flex flex-col lg:flex-row lg:gap-16 w-full">
      <div class="w-full lg:w-2/3">
        <div
          id="article"
          data-image-layout={imageLayout}
          class="prose dark:prose-invert max-w-none text-[#202020] dark:text-[#96a6e2]"
          >
          <slot />
        </div>
        <div class="mt-8">
          <LinkPreview />
        </div>
        <Comments slug={Astro.url.pathname} />
      </div>
      
      <aside class="w-full lg:w-1/3 mt-12 lg:mt-0">
        <div class="border border-[#202020] dark:border-[#7c8fd1] p-6 rounded">
          <div class="flex items-center py-2">
            <Image
            src={info.picture}
            alt={info.picture_alt}
            class="mr-3 h-12 w-12 rounded-full object-cover"
            height={48}
            width={48}
            />
            <div>
              <p
              class="text-xs font-semibold text-[#202020]/70 dark:text-[#96a6e2]/70"
              >
              Author
            </p>
            <a
            class="text-sm font-bold text-[#202020] dark:text-[#7c8fd1] hover:underline"
            href="/">{info.name}</a
            >
            <br />
            <a
            class="text-sm text-[#202020] dark:text-[#96a6e2] hover:underline"
            href="/about"
            >About Nick <span
            class="text-[#202020]/70 dark:text-[#96a6e2]/70">→</span
            >
          </a>
        </div>
      </div>
      <p class="py-3 text-sm text-[#202020] dark:text-[#96a6e2]">
        {info.brief_description}
      </p>
      <Contact contact={info.contact} size="md" />
    </div>
    <div class="mt-8">
      <RecentPosts posts={filteredPosts} />
      
      <div class="mt-4">
        <ProtonAdAstroComponent />
      </div>
      
      <div class="flex flex-col gap-2 mt-4">
        <ViewBlog />
      </div>
    </div>
  </aside>
</div>
  <section class="pt-6">
    <h2 class="mb-4 text-xl font-semibold text-[#202020] dark:text-[#7c8fd1]">
      Notes from Nick
    </h2>

    <p class="m-1 mb-4 text-[#202020] dark:text-[#7c8fd1]">
      Thanks for reading! This post was written by <a
        href="/about"
        class="underline">Nick Stambaugh</a
      >, not AI.
    </p>

    <ul class="list-disc space-y-2 pl-5 text-[#202020] dark:text-[#7c8fd1]">
      <li>
        Stay up to date with Nick's latest posts via
        <a href="/rss.xml" class="underline">RSS</a>
      </li>
      <li>
        Have a question or want to discuss a topic?
        <a href="mailto:nickstambaugh@proton.me" class="underline"
          >Email Nick</a
        >
      </li>
      <li>
        This website costs money to maintain and contains only one advertisement.
        Consider
        <a href="https://buymeacoffee.com/nickstambaugh" class="underline"
          >buying Nick a coffee</a
        >
        as a token of appreciation.
      </li>
    </ul>
  </section>
    <footer class="mt-16 pt-8 border-t border-text/10 dark:border-dk-text/10">
      <a
        href="/posts"
        class="text-sm text-text/60 hover:text-secondary dark:hover:text-dk-accent transition-colors"
      >
        ← Back to blog
      </a>
    </footer>
  </main>
</BaseLayout>